/// Random numbers (spec chapter 09).
///
/// - The `secure_*` functions use the cryptographic generator of the operating system:
///   use them for keys, passwords, tokens and identifiers.
/// - `Rng` is a fast generator (xoshiro256**) for games and simulations. Created with
///   `Rng.new(seed)`, it gives the same numbers on every system; it is not suitable for
///   cryptography.

import std.mem
import std.sys

unsafe fn rt_os_random(buffer: Ptr[u8], length: usize) -> bool {
    return sys.random_bytes(buffer, length)
}

const SIGN_BIT: u64 = 0x8000_0000_0000_0000

/// Maps an `i64` to a `u64` in the same order: `i64.MIN` → 0, 0 → 2^63.
fn to_ordered(x: i64) -> u64 {
    if x < 0 {
        return (x - i64.MIN) as u64
    }
    return (x as u64) + SIGN_BIT
}

/// The inverse of `to_ordered`.
fn from_ordered(u: u64) -> i64 {
    if u < SIGN_BIT {
        return (u as i64) + i64.MIN
    }
    return (u - SIGN_BIT) as i64
}

/// `count` cryptographically secure random bytes.
pub fn secure_bytes(count: usize) -> Vec[u8] {
    var bytes: Vec[u8] = Vec.with_capacity(count)
    if count == 0 {
        return bytes
    }
    unsafe {
        let buffer = mem.alloc(count)
        let ok = rt_os_random(buffer, count)
        if ok {
            for i in 0..count {
                bytes.push(buffer.offset(i).read())
            }
        }
        mem.free(buffer)
        if not ok {
            panic("the random generator of the system is unavailable")
        }
    }
    return bytes
}

/// A cryptographically secure random number.
pub fn secure_u64() -> u64 {
    var value: u64 = 0
    unsafe {
        let buffer = mem.alloc(8)
        let ok = rt_os_random(buffer, 8)
        if ok {
            for i in 0..8 {
                value = (value << 8) | (buffer.offset(i).read() as u64)
            }
        }
        mem.free(buffer)
        if not ok {
            panic("the random generator of the system is unavailable")
        }
    }
    return value
}

/// A cryptographically secure random integer from `min` (included) to `max`
/// (excluded); every value has the same probability.
@track_caller
pub fn secure_range(min: i64, max: i64) -> i64 {
    if min >= max {
        panic("empty range {min}..{max}")
    }
    let span = to_ordered(max) - to_ordered(min)
    // Values below `threshold` would make some results more likely: they are redrawn.
    let threshold = (0 -% span) % span
    while true {
        let r = secure_u64()
        if r >= threshold {
            return from_ordered(to_ordered(min) + r % span)
        }
    }
}

/// A cryptographically secure random text of `length` letters and digits, for
/// passwords, tokens and identifiers.
pub fn secure_token(length: usize) -> String {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".chars()
    var token = String.with_capacity(length)
    for _ in 0..length {
        token.push(alphabet[secure_range(0, 62) as usize])
    }
    return token
}

/// SplitMix64: turns a seed into well-mixed numbers (to fill the state of `Rng`).
fn splitmix(inout state: u64) -> u64 {
    state = state +% 0x9E37_79B9_7F4A_7C15
    var z = state
    z = (z ^ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB
    return z ^ (z >> 31)
}

fn rotate_left(x: u64, k: u64) -> u64 {
    return (x << k) | (x >> (64 - k))
}

/// A fast random generator (xoshiro256**, period 2^256 - 1) for games and simulations.
pub struct Rng {
    s0: u64
    s1: u64
    s2: u64
    s3: u64
}

impl Rng {
    /// A generator started from `seed`: the same seed gives the same numbers, on every
    /// system.
    pub fn new(seed: u64) -> Rng {
        var s = seed
        let a = splitmix(&s)
        let b = splitmix(&s)
        let c = splitmix(&s)
        let d = splitmix(&s)
        return Rng(s0: a, s1: b, s2: c, s3: d)
    }

    /// A generator started from the random generator of the system: different numbers
    /// on every run.
    pub fn from_entropy() -> Rng {
        var r = Rng(s0: secure_u64(), s1: secure_u64(), s2: secure_u64(), s3: secure_u64())
        if r.s0 == 0 and r.s1 == 0 and r.s2 == 0 and r.s3 == 0 {
            r.s0 = 1
        }
        return r
    }

    /// The next random number: every `u64` value has the same probability.
    pub fn next_u64(inout self) -> u64 {
        let result = rotate_left(self.s1 *% 5, 7) *% 9
        let t = self.s1 << 17
        self.s2 ^= self.s0
        self.s3 ^= self.s1
        self.s1 ^= self.s2
        self.s0 ^= self.s3
        self.s2 ^= t
        self.s3 = rotate_left(self.s3, 45)
        return result
    }

    /// A random integer from `min` (included) to `max` (excluded); every value has the
    /// same probability.
    @track_caller
    pub fn range(inout self, min: i64, max: i64) -> i64 {
        if min >= max {
            panic("empty range {min}..{max}")
        }
        let span = to_ordered(max) - to_ordered(min)
        let threshold = (0 -% span) % span
        while true {
            let r = self.next_u64()
            if r >= threshold {
                return from_ordered(to_ordered(min) + r % span)
            }
        }
    }

    /// A random position in a list of `length` elements: from 0 to `length - 1`.
    @track_caller
    pub fn index(inout self, length: usize) -> usize {
        if length == 0 {
            panic("no position in an empty list")
        }
        return self.range(0, length as i64) as usize
    }

    /// A random number from 0.0 (included) to 1.0 (excluded).
    pub fn float(inout self) -> f64 {
        // The 53 high bits: every representable multiple of 2^-53 has the same probability.
        return ((self.next_u64() >> 11) as f64) * (1.0 / 9_007_199_254_740_992.0)
    }

    /// `true` with the probability `probability` (from 0.0 to 1.0).
    pub fn chance(inout self, probability: f64) -> bool {
        return self.float() < probability
    }

    /// Puts the elements of `items` in a random order (every order has the same
    /// probability: Fisher–Yates shuffle).
    pub fn shuffle[T](inout self, inout items: Vec[T]) {
        var i = items.len()
        while i > 1 {
            let j = self.index(i)
            i -= 1
            items.swap(i, j)
        }
    }
}
