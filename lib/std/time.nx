/// Time: clocks, calendar dates and pauses (spec chapter 09).
///
/// Two clocks:
/// - `monotonic_ns()` never goes backwards: use it to measure durations;
/// - `unix_time()` and `DateTime.now()` read the system clock, which the user or the
///   network can adjust.
///
/// Dates follow the proleptic Gregorian calendar, and a `Date` is always a valid date.

import std.sys

/// Nanoseconds elapsed since an arbitrary fixed point; never goes backwards.
/// Use the difference between two calls to measure a duration.
pub fn monotonic_ns() -> u64 {
    return sys.monotonic_ns()
}

fn rt_unix_time_ns() -> i64 {
    return sys.unix_time_ns()
}

fn rt_utc_offset(unix_seconds: i64) -> i32 {
    return sys.utc_offset(unix_seconds)
}

fn rt_sleep_ns(nanoseconds: u64) {
    sys.sleep_ns(nanoseconds)
}

const NS_PER_SECOND: i64 = 1_000_000_000
const SECONDS_PER_DAY: i64 = 86_400

/// Division rounded towards negative infinity.
fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 and (a < 0) != (b < 0) {
        return q - 1
    }
    return q
}

/// The remainder of `floor_div`: between 0 and `b - 1` when `b > 0`.
fn floor_mod(a: i64, b: i64) -> i64 {
    return a - floor_div(a, b) * b
}

/// Nanoseconds since 1970-01-01 00:00:00 UTC, from the system clock.
pub fn unix_time_ns() -> i64 {
    return rt_unix_time_ns()
}

/// Whole seconds since 1970-01-01 00:00:00 UTC, from the system clock.
pub fn unix_time() -> i64 {
    return floor_div(rt_unix_time_ns(), NS_PER_SECOND)
}

/// The offset of local time from UTC at the instant `unix_seconds`, in seconds
/// (daylight saving time included): `7200` for UTC+2.
pub fn utc_offset(unix_seconds: i64) -> i32 {
    return rt_utc_offset(unix_seconds)
}

/// Suspends the program for at least `milliseconds` milliseconds.
pub fn sleep(milliseconds: u64) {
    // Beyond about 584 years, the duration in nanoseconds does not fit in a u64.
    if milliseconds > 18_446_744_073_709 {
        rt_sleep_ns(u64.MAX)
    } else {
        rt_sleep_ns(milliseconds * 1_000_000)
    }
}

/// Suspends the program for at least `nanoseconds` nanoseconds. The precision depends
/// on the system: better than a millisecond on current systems.
pub fn sleep_ns(nanoseconds: u64) {
    rt_sleep_ns(nanoseconds)
}

/// The current local date and time (same as `DateTime.now()`).
pub fn now() -> DateTime {
    return DateTime.now()
}

/// Today's local date (same as `Date.today()`).
pub fn today() -> Date {
    return DateTime.now().on
}

/// `true` if `year` is a leap year.
pub fn is_leap_year(year: i32) -> bool {
    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
}

/// The number of days of `month` (1 to 12) in `year`.
@track_caller
pub fn days_in_month(year: i32, month: i32) -> i32 {
    return match month {
        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31
        4 | 6 | 9 | 11 => 30
        2 => if is_leap_year(year) { 29 } else { 28 }
        _ => panic("invalid month {month}: expected 1 to 12")
    }
}

/// A day of the week.
pub enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

impl Weekday {
    /// 1 for Monday to 7 for Sunday (ISO 8601).
    pub fn number(self) -> i32 {
        return match self {
            Monday => 1
            Tuesday => 2
            Wednesday => 3
            Thursday => 4
            Friday => 5
            Saturday => 6
            Sunday => 7
        }
    }

    /// The day numbered `number`: 1 for Monday to 7 for Sunday.
    pub fn from_number(number: i32) -> Option[Weekday] {
        return match number {
            1 => Some(Weekday.Monday)
            2 => Some(Weekday.Tuesday)
            3 => Some(Weekday.Wednesday)
            4 => Some(Weekday.Thursday)
            5 => Some(Weekday.Friday)
            6 => Some(Weekday.Saturday)
            7 => Some(Weekday.Sunday)
            _ => None
        }
    }

    /// The English name of the day: "Monday" to "Sunday".
    pub fn name(self) -> String {
        return match self {
            Monday => "Monday"
            Tuesday => "Tuesday"
            Wednesday => "Wednesday"
            Thursday => "Thursday"
            Friday => "Friday"
            Saturday => "Saturday"
            Sunday => "Sunday"
        }
    }
}

/// A calendar date, always valid.
pub struct Date {
    year: i32
    month: i32
    day: i32
}

impl Date {
    /// The date `year`-`month`-`day`, or `None` if it does not exist.
    pub fn new(year: i32, month: i32, day: i32) -> Option[Date] {
        if month < 1 or month > 12 {
            return None
        }
        if day < 1 or day > days_in_month(year, month) {
            return None
        }
        return Some(Date(year: year, month: month, day: day))
    }

    /// Today's local date.
    pub fn today() -> Date {
        return DateTime.now().on
    }

    /// The date `days` days after 1970-01-01 (before it when `days` is negative).
    pub fn from_days(days: i64) -> Date {
        // "civil_from_days", by Howard Hinnant: years of 400 years ("eras") starting on
        // March 1st, so that the leap day is the last day of the year.
        let z = days + 719_468
        let era = floor_div(z, 146_097)
        let day_of_era = z - era * 146_097
        let year_of_era = (day_of_era - day_of_era / 1_460 + day_of_era / 36_524 - day_of_era / 146_096) / 365
        let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
        let month_from_march = (5 * day_of_year + 2) / 153
        let day = day_of_year - (153 * month_from_march + 2) / 5 + 1
        let month = if month_from_march < 10 { month_from_march + 3 } else { month_from_march - 9 }
        let year = year_of_era + era * 400 + (if month <= 2 { 1 } else { 0 })
        return Date(year: year as i32, month: month as i32, day: day as i32)
    }

    /// The number of days from 1970-01-01 to this date (negative before 1970).
    pub fn days_since_epoch(self) -> i64 {
        // "days_from_civil", by Howard Hinnant (the inverse of `from_days`).
        let m = self.month as i64
        let y = (self.year as i64) - (if m <= 2 { 1 } else { 0 })
        let era = floor_div(y, 400)
        let year_of_era = y - era * 400
        let day_of_year = (153 * (if m > 2 { m - 3 } else { m + 9 }) + 2) / 5 + (self.day as i64) - 1
        let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
        return era * 146_097 + day_of_era - 719_468
    }

    pub fn year(self) -> i32 {
        return self.year
    }

    /// The month, from 1 (January) to 12 (December).
    pub fn month(self) -> i32 {
        return self.month
    }

    /// The day of the month, from 1.
    pub fn day(self) -> i32 {
        return self.day
    }

    /// The day of the week.
    pub fn weekday(self) -> Weekday {
        // 1970-01-01 was a Thursday.
        return Weekday.from_number(floor_mod(self.days_since_epoch() + 3, 7) as i32 + 1).unwrap()
    }

    /// The day of the year: 1 for January 1st, up to 366.
    pub fn day_of_year(self) -> i32 {
        let first = Date(year: self.year, month: 1, day: 1)
        return (self.days_since_epoch() - first.days_since_epoch()) as i32 + 1
    }

    /// The date `days` days later (earlier when `days` is negative).
    pub fn add_days(self, days: i64) -> Date {
        return Date.from_days(self.days_since_epoch() + days)
    }

    /// The same day `months` months later (earlier when negative). The day is reduced to
    /// the length of the month: January 31 plus one month is February 28 (or 29).
    pub fn add_months(self, months: i32) -> Date {
        let total = (self.year as i64) * 12 + (self.month as i64) - 1 + (months as i64)
        let year = floor_div(total, 12) as i32
        let month = floor_mod(total, 12) as i32 + 1
        let last = days_in_month(year, month)
        return Date(year: year, month: month, day: if self.day > last { last } else { self.day })
    }

    /// The same day `years` years later (earlier when negative); February 29 becomes
    /// February 28 in a common year.
    pub fn add_years(self, years: i32) -> Date {
        return self.add_months(years * 12)
    }

    /// The number of days from this date to `other` (negative when `other` is earlier).
    pub fn days_until(self, other: Date) -> i64 {
        return other.days_since_epoch() - self.days_since_epoch()
    }

    /// The number of whole years from this date to `other`: the age on `other` of
    /// someone born on this date (negative when `other` is earlier).
    pub fn years_until(self, other: Date) -> i32 {
        if other.days_since_epoch() < self.days_since_epoch() {
            return -other.years_until(self)
        }
        var years = other.year - self.year
        if other.month < self.month or (other.month == self.month and other.day < self.day) {
            years -= 1
        }
        return years
    }

    /// `true` if this date is before `other`.
    pub fn is_before(self, other: Date) -> bool {
        return self.days_since_epoch() < other.days_since_epoch()
    }

    /// `true` if both dates are the same day.
    pub fn equals(self, other: Date) -> bool {
        return self.year == other.year and self.month == other.month and self.day == other.day
    }

    /// The date written `YYYY-MM-DD` (ISO 8601).
    pub fn to_string(self) -> String {
        return "{self.year:04}-{self.month:02}-{self.day:02}"
    }

    /// Reads a date written `YYYY-MM-DD` (ISO 8601).
    pub fn parse(text: String) -> Option[Date] {
        let parts = text.trim().split("-")
        if parts.len() != 3 or parts[0].len() != 4 or parts[1].len() != 2 or parts[2].len() != 2 {
            return None
        }
        match (parts[0].parse_int(), parts[1].parse_int(), parts[2].parse_int()) {
            (Some(y), Some(m), Some(d)) => {
                if y < 0 or m < 0 or d < 0 {
                    return None
                }
                return Date.new(y as i32, m as i32, d as i32)
            }
            _ => return None
        }
    }
}

/// A date and a time of day, in a time zone given by its offset from UTC.
pub struct DateTime {
    // Not named `date`: a field sharing its name with a method of struct type is not
    // yet supported by the compiler (infinite recursion, to be fixed).
    on: Date
    hour: i32
    minute: i32
    second: i32
    nanosecond: i32
    offset: i32
}

impl DateTime {
    /// The current date and time in the local time zone.
    pub fn now() -> DateTime {
        let ns = rt_unix_time_ns()
        let seconds = floor_div(ns, NS_PER_SECOND)
        return DateTime.from_unix(seconds, floor_mod(ns, NS_PER_SECOND) as i32, rt_utc_offset(seconds))
    }

    /// The current date and time in UTC.
    pub fn now_utc() -> DateTime {
        let ns = rt_unix_time_ns()
        return DateTime.from_unix(floor_div(ns, NS_PER_SECOND), floor_mod(ns, NS_PER_SECOND) as i32, 0)
    }

    /// The instant `unix_seconds` (seconds since 1970-01-01 00:00:00 UTC) plus
    /// `nanosecond`, expressed in the time zone `utc_offset` (seconds east of UTC).
    @track_caller
    pub fn from_unix(unix_seconds: i64, nanosecond: i32, utc_offset: i32) -> DateTime {
        if nanosecond < 0 or nanosecond >= 1_000_000_000 {
            panic("invalid nanosecond {nanosecond}: expected 0 to 999 999 999")
        }
        let local = unix_seconds + (utc_offset as i64)
        let rest = floor_mod(local, SECONDS_PER_DAY)
        return DateTime(
            on: Date.from_days(floor_div(local, SECONDS_PER_DAY)),
            hour: (rest / 3600) as i32,
            minute: (rest % 3600 / 60) as i32,
            second: (rest % 60) as i32,
            nanosecond: nanosecond,
            offset: utc_offset,
        )
    }

    /// The time `hour:minute:second` of `date` in the local time zone, or `None` if the
    /// time is not valid. Daylight saving time is taken into account.
    pub fn local(date: Date, hour: i32, minute: i32, second: i32) -> Option[DateTime] {
        if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59 {
            return None
        }
        let wall = date.days_since_epoch() * SECONDS_PER_DAY + (hour * 3600 + minute * 60 + second) as i64
        // The offset depends on the instant, which depends on the offset: two passes
        // settle it, also around a change of daylight saving time.
        var offset = rt_utc_offset(wall)
        offset = rt_utc_offset(wall - (offset as i64))
        return Some(DateTime.from_unix(wall - (offset as i64), 0, offset))
    }

    /// The time `hour:minute:second` (UTC) of `date`, or `None` if the time is not valid.
    pub fn utc(date: Date, hour: i32, minute: i32, second: i32) -> Option[DateTime] {
        if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59 {
            return None
        }
        return Some(DateTime(on: date, hour: hour, minute: minute, second: second, nanosecond: 0, offset: 0))
    }

    pub fn date(self) -> Date {
        return self.on
    }

    pub fn hour(self) -> i32 {
        return self.hour
    }

    pub fn minute(self) -> i32 {
        return self.minute
    }

    pub fn second(self) -> i32 {
        return self.second
    }

    pub fn nanosecond(self) -> i32 {
        return self.nanosecond
    }

    /// The offset of the time zone from UTC, in seconds (east of UTC is positive).
    pub fn utc_offset(self) -> i32 {
        return self.offset
    }

    pub fn weekday(self) -> Weekday {
        return self.on.weekday()
    }

    /// Seconds since 1970-01-01 00:00:00 UTC.
    pub fn unix_time(self) -> i64 {
        let of_day = (self.hour * 3600 + self.minute * 60 + self.second) as i64
        return self.on.days_since_epoch() * SECONDS_PER_DAY + of_day - (self.offset as i64)
    }

    /// The number of seconds from this instant to `other` (negative when earlier).
    pub fn seconds_until(self, other: DateTime) -> i64 {
        return other.unix_time() - self.unix_time()
    }

    /// The same instant `seconds` seconds later (earlier when negative).
    pub fn add_seconds(self, seconds: i64) -> DateTime {
        return DateTime.from_unix(self.unix_time() + seconds, self.nanosecond, self.offset)
    }

    /// The same instant, expressed in the time zone `utc_offset`.
    pub fn with_offset(self, utc_offset: i32) -> DateTime {
        return DateTime.from_unix(self.unix_time(), self.nanosecond, utc_offset)
    }

    /// `YYYY-MM-DD HH:MM:SS`, in the time zone of the value.
    pub fn to_string(self) -> String {
        return "{self.on.to_string()} {self.hour:02}:{self.minute:02}:{self.second:02}"
    }

    /// ISO 8601 with the offset: `2026-10-13T22:41:37+02:00`, or `...Z` in UTC.
    pub fn to_iso(self) -> String {
        let time = "{self.on.to_string()}T{self.hour:02}:{self.minute:02}:{self.second:02}"
        if self.offset == 0 {
            return time + "Z"
        }
        let sign = if self.offset < 0 { "-" } else { "+" }
        let minutes = (if self.offset < 0 { -self.offset } else { self.offset }) / 60
        return time + "{sign}{minutes / 60:02}:{minutes % 60:02}"
    }
}
