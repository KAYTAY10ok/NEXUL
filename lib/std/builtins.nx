// edition: 1
/// Software floating point (IEEE 754) for processors without a double-precision
/// floating-point unit: Cortex-M0/M3/M4, RISC-V without the F/D extensions (spec §7.1).
///
/// LLVM turns the floating-point operations of a program for these processors into calls
/// to the functions below. They work on the bit patterns of the numbers with integer
/// operations only (a floating-point operation here would call itself), round to nearest
/// with ties to even, and handle subnormal numbers, infinities and NaN. The algorithms
/// follow Berkeley SoftFloat (John R. Hauser, BSD licence).
///
/// `f32` operations are computed in `f64` and rounded once: the double has enough
/// precision (53 >= 2 × 24 + 2 bits) for the result to be correctly rounded.

import std.math

const u64 SIGN = 0x8000_0000_0000_0000
const u64 FRAC = 0x000F_FFFF_FFFF_FFFF
const u64 IMPLICIT = 0x0010_0000_0000_0000
const u64 QUIET_NAN = 0x7FF8_0000_0000_0000

fn u64 bits(f64 x) {
    return x.to_bits()
}

fn f64 float(u64 b) {
    return math.f64_from_bits(b)
}

fn u64 pack(u64 sign, u64 exp, u64 sig) {
    // `sig` may carry into the exponent (the leading bit of a normal significand).
    return (sign << 63) +% (exp << 52) +% sig
}

fn i32 exp_of(u64 a) {
    return ((a >> 52) & 0x7FF) as i32
}

fn bool is_nan(u64 a) {
    return (a & 0x7FFF_FFFF_FFFF_FFFF) > 0x7FF0_0000_0000_0000
}

/// The quiet NaN to return when an operand is a NaN.
fn u64 propagate_nan(u64 a, u64 b) {
    if is_nan(a) {
        return a | 0x0008_0000_0000_0000
    }
    return b | 0x0008_0000_0000_0000
}

/// `a >> dist`, with the lowest bit set if a nonzero bit was shifted out ("sticky").
fn u64 shift_right_jam(u64 a, u32 dist) {
    if dist == 0 {
        return a
    }
    if dist < 63 {
        let lost = a << ((64 - dist) as u64)
        return (a >> (dist as u64)) | (if lost != 0 { 1 } else { 0 })
    }
    return if a != 0 { 1 } else { 0 }
}

/// Rounds and packs a result: `sig` has its leading bit at bit 62, `exp` is the biased
/// exponent minus one (SoftFloat's convention).
fn u64 round_pack(u64 sign, i32 exp0, u64 sig0) {
    var exp = exp0
    var sig = sig0
    var round_bits = sig & 0x3FF
    if exp < 0 or exp >= 0x7FD {
        if exp < 0 {
            sig = shift_right_jam(sig, (0 - exp) as u32)
            exp = 0
            round_bits = sig & 0x3FF
        } else if exp > 0x7FD or sig >= SIGN - 0x200 {
            return pack(sign, 0x7FF, 0)
        }
    }
    sig = (sig + 0x200) >> 10
    if round_bits == 0x200 {
        sig &= 0xFFFF_FFFF_FFFF_FFFE
    }
    if sig == 0 {
        exp = 0
    }
    return pack(sign, exp as u64, sig)
}

fn u64 norm_round_pack(u64 sign, i32 exp, u64 sig) {
    let shift = sig.leading_zeros() as i32 - 1
    let e = exp - shift
    if shift >= 10 and e >= 0 and e < 0x7FD {
        return pack(sign, if sig != 0 { e as u64 } else { 0 }, sig << ((shift - 10) as u64))
    }
    return round_pack(sign, e, sig << (shift as u64))
}

fn u64 add_mags(u64 a, u64 b, u64 sign) {
    let exp_a = exp_of(a)
    let exp_b = exp_of(b)
    var sig_a = a & FRAC
    var sig_b = b & FRAC
    let diff = exp_a - exp_b
    if diff == 0 {
        if exp_a == 0 {
            return a +% sig_b
        }
        if exp_a == 0x7FF {
            if (sig_a | sig_b) != 0 {
                return propagate_nan(a, b)
            }
            return a
        }
        return round_pack(sign, exp_a, (0x0020_0000_0000_0000 + sig_a + sig_b) << 9)
    }
    sig_a <<= 9
    sig_b <<= 9
    var i32 exp_z = 0
    if diff < 0 {
        if exp_b == 0x7FF {
            if sig_b != 0 {
                return propagate_nan(a, b)
            }
            return pack(sign, 0x7FF, 0)
        }
        exp_z = exp_b
        if exp_a != 0 {
            sig_a += 0x2000_0000_0000_0000
        } else {
            sig_a <<= 1
        }
        sig_a = shift_right_jam(sig_a, (0 - diff) as u32)
    } else {
        if exp_a == 0x7FF {
            if sig_a != 0 {
                return propagate_nan(a, b)
            }
            return a
        }
        exp_z = exp_a
        if exp_b != 0 {
            sig_b += 0x2000_0000_0000_0000
        } else {
            sig_b <<= 1
        }
        sig_b = shift_right_jam(sig_b, diff as u32)
    }
    var sig_z = 0x2000_0000_0000_0000 + sig_a + sig_b
    if sig_z < 0x4000_0000_0000_0000 {
        exp_z -= 1
        sig_z <<= 1
    }
    return round_pack(sign, exp_z, sig_z)
}

fn u64 sub_mags(u64 a, u64 b, u64 sign0) {
    var sign = sign0
    let exp_a = exp_of(a)
    let exp_b = exp_of(b)
    var sig_a = a & FRAC
    var sig_b = b & FRAC
    let diff = exp_a - exp_b
    if diff == 0 {
        if exp_a == 0x7FF {
            if (sig_a | sig_b) != 0 {
                return propagate_nan(a, b)
            }
            return QUIET_NAN
        }
        if sig_a == sig_b {
            return 0
        }
        let e = if exp_a != 0 { exp_a - 1 } else { 0 }
        var u64 d = 0
        if sig_a < sig_b {
            sign = 1 - sign
            d = sig_b - sig_a
        } else {
            d = sig_a - sig_b
        }
        var shift = d.leading_zeros() as i32 - 11
        var exp_z = e - shift
        if exp_z < 0 {
            shift = e
            exp_z = 0
        }
        return pack(sign, exp_z as u64, d << (shift as u64))
    }
    sig_a <<= 10
    sig_b <<= 10
    var u64 sig_z = 0
    var i32 exp_z = 0
    if diff < 0 {
        sign = 1 - sign
        if exp_b == 0x7FF {
            if sig_b != 0 {
                return propagate_nan(a, b)
            }
            return pack(sign, 0x7FF, 0)
        }
        sig_a += if exp_a != 0 { 0x4000_0000_0000_0000 } else { sig_a }
        sig_a = shift_right_jam(sig_a, (0 - diff) as u32)
        sig_b |= 0x4000_0000_0000_0000
        exp_z = exp_b
        sig_z = sig_b - sig_a
    } else {
        if exp_a == 0x7FF {
            if sig_a != 0 {
                return propagate_nan(a, b)
            }
            return a
        }
        sig_b += if exp_b != 0 { 0x4000_0000_0000_0000 } else { sig_b }
        sig_b = shift_right_jam(sig_b, diff as u32)
        sig_a |= 0x4000_0000_0000_0000
        exp_z = exp_a
        sig_z = sig_a - sig_b
    }
    return norm_round_pack(sign, exp_z - 1, sig_z)
}

pub fn u64 f64_add(u64 a, u64 b) {
    let sa = a >> 63
    if sa == b >> 63 {
        return add_mags(a, b, sa)
    }
    return sub_mags(a, b, sa)
}

pub fn u64 f64_sub(u64 a, u64 b) {
    let sa = a >> 63
    if sa == b >> 63 {
        return sub_mags(a, b, sa)
    }
    return add_mags(a, b, sa)
}

/// The full 128-bit product of two 64-bit numbers: (high, low).
fn (u64, u64) mul_wide(u64 a, u64 b) {
    let a0 = a & 0xFFFF_FFFF
    let a1 = a >> 32
    let b0 = b & 0xFFFF_FFFF
    let b1 = b >> 32
    let p00 = a0 * b0
    let p01 = a0 * b1
    let p10 = a1 * b0
    let p11 = a1 * b1
    let mid = (p00 >> 32) + (p01 & 0xFFFF_FFFF) + (p10 & 0xFFFF_FFFF)
    let lo = (p00 & 0xFFFF_FFFF) | ((mid & 0xFFFF_FFFF) << 32)
    let hi = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
    return (hi, lo)
}

/// A subnormal significand normalized: (exponent, significand with bit 52 set).
fn (i32, u64) normalize(u64 sig) {
    let shift = sig.leading_zeros() as i32 - 11
    return (1 - shift, sig << (shift as u64))
}

pub fn u64 f64_mul(u64 a, u64 b) {
    let sign = (a ^ b) >> 63
    var exp_a = exp_of(a)
    var exp_b = exp_of(b)
    var sig_a = a & FRAC
    var sig_b = b & FRAC
    if exp_a == 0x7FF {
        if sig_a != 0 or (exp_b == 0x7FF and sig_b != 0) {
            return propagate_nan(a, b)
        }
        if exp_b == 0 and sig_b == 0 {
            return QUIET_NAN
        }
        return pack(sign, 0x7FF, 0)
    }
    if exp_b == 0x7FF {
        if sig_b != 0 {
            return propagate_nan(a, b)
        }
        if exp_a == 0 and sig_a == 0 {
            return QUIET_NAN
        }
        return pack(sign, 0x7FF, 0)
    }
    if exp_a == 0 {
        if sig_a == 0 {
            return pack(sign, 0, 0)
        }
        let (e, s) = normalize(sig_a)
        exp_a = e
        sig_a = s
    }
    if exp_b == 0 {
        if sig_b == 0 {
            return pack(sign, 0, 0)
        }
        let (e, s) = normalize(sig_b)
        exp_b = e
        sig_b = s
    }
    var exp_z = exp_a + exp_b - 0x3FF
    let (hi, lo) = mul_wide((sig_a | IMPLICIT) << 10, (sig_b | IMPLICIT) << 11)
    var sig_z = hi | (if lo != 0 { 1 } else { 0 })
    if sig_z < 0x4000_0000_0000_0000 {
        exp_z -= 1
        sig_z <<= 1
    }
    return round_pack(sign, exp_z, sig_z)
}

pub fn u64 f64_div(u64 a, u64 b) {
    let sign = (a ^ b) >> 63
    var exp_a = exp_of(a)
    var exp_b = exp_of(b)
    var sig_a = a & FRAC
    var sig_b = b & FRAC
    if exp_a == 0x7FF {
        if sig_a != 0 {
            return propagate_nan(a, b)
        }
        if exp_b == 0x7FF {
            if sig_b != 0 {
                return propagate_nan(a, b)
            }
            return QUIET_NAN
        }
        return pack(sign, 0x7FF, 0)
    }
    if exp_b == 0x7FF {
        if sig_b != 0 {
            return propagate_nan(a, b)
        }
        return pack(sign, 0, 0)
    }
    if exp_b == 0 {
        if sig_b == 0 {
            if exp_a == 0 and sig_a == 0 {
                return QUIET_NAN
            }
            return pack(sign, 0x7FF, 0)
        }
        let (e, s) = normalize(sig_b)
        exp_b = e
        sig_b = s
    }
    if exp_a == 0 {
        if sig_a == 0 {
            return pack(sign, 0, 0)
        }
        let (e, s) = normalize(sig_a)
        exp_a = e
        sig_a = s
    }
    var exp_z = exp_a - exp_b + 0x3FE
    var rem = sig_a | IMPLICIT
    let d = sig_b | IMPLICIT
    if rem < d {
        exp_z -= 1
        rem <<= 1
    }
    // Long division: 63 quotient bits, then a sticky bit for the remainder.
    var u64 q = 0
    for _ in 0..63 {
        q <<= 1
        if rem >= d {
            rem -= d
            q |= 1
        }
        rem <<= 1
    }
    if rem != 0 {
        q |= 1
    }
    return round_pack(sign, exp_z, q)
}

pub fn u64 f64_sqrt(u64 a) {
    let sign = a >> 63
    var exp = exp_of(a)
    var sig = a & FRAC
    if exp == 0x7FF {
        if sig != 0 {
            return propagate_nan(a, a)
        }
        if sign == 0 {
            return a
        }
        return QUIET_NAN
    }
    if sign == 1 {
        if exp == 0 and sig == 0 {
            return a
        }
        return QUIET_NAN
    }
    if exp == 0 {
        if sig == 0 {
            return a
        }
        let (e, s) = normalize(sig)
        exp = e
        sig = s
    }
    // value = m / 2^52 * 2^e with m in [2^52, 2^53); make e even.
    var e = exp - 1023
    var m = sig | IMPLICIT
    if e % 2 != 0 {
        m <<= 1
        e -= 1
    }
    // root = floor(sqrt(m * 2^56)): 55 bits, by pairs of bits of the 110-bit radicand.
    let hi = m >> 8
    let lo = (m & 0xFF) << 56
    var u64 rem = 0
    var u64 root = 0
    for i in 0..55 {
        let p = 109 - 2 * (i as u32)
        let b1 = if p >= 64 { (hi >> ((p - 64) as u64)) & 1 } else { (lo >> (p as u64)) & 1 }
        let q = p - 1
        let b0 = if q >= 64 { (hi >> ((q - 64) as u64)) & 1 } else { (lo >> (q as u64)) & 1 }
        rem = (rem << 2) | (b1 << 1) | b0
        let trial = (root << 2) | 1
        if rem >= trial {
            rem -= trial
            root = (root << 1) | 1
        } else {
            root <<= 1
        }
    }
    let sig_z = (root << 8) | (if rem != 0 { 1 } else { 0 })
    return round_pack(0, e / 2 + 1022, sig_z)
}

/// -1 less, 0 equal, 1 greater, 2 unordered.
pub fn i32 f64_compare(u64 a, u64 b) {
    if is_nan(a) or is_nan(b) {
        return 2
    }
    if ((a | b) & 0x7FFF_FFFF_FFFF_FFFF) == 0 {
        return 0
    }
    let sa = a >> 63
    let sb = b >> 63
    if sa != sb {
        return if sa == 1 { -1 } else { 1 }
    }
    if a == b {
        return 0
    }
    let less = (a < b) != (sa == 1)
    return if less { -1 } else { 1 }
}

/// Truncation toward zero; saturates outside of the range (callers check the range).
fn u64 f64_to_int(u64 a, u32 max_bits, bool signed) {
    let sign = a >> 63
    let exp = exp_of(a)
    if is_nan(a) {
        return 0
    }
    let e = exp - 1023
    if e < 0 {
        return 0
    }
    let limit = if signed { max_bits - 1 } else { max_bits }
    if e as u32 >= limit or (sign == 1 and not signed) {
        if sign == 1 and not signed {
            return 0
        }
        if signed {
            let m = (1 as u64) << ((max_bits - 1) as u64)
            return if sign == 1 { m } else { m - 1 }
        }
        return if max_bits == 64 { 0xFFFF_FFFF_FFFF_FFFF } else { ((1 as u64) << (max_bits as u64)) - 1 }
    }
    let m = (a & FRAC) | IMPLICIT
    let v = if e >= 52 { m << ((e - 52) as u64) } else { m >> ((52 - e) as u64) }
    if sign == 1 {
        return 0 -% v
    }
    return v
}

/// The `f64` nearest to `sign * mag`.
fn u64 f64_from_magnitude(u64 sign, u64 mag) {
    if mag == 0 {
        return pack(sign, 0, 0)
    }
    let shift = mag.leading_zeros()
    let sig = shift_right_jam(mag << (shift as u64), 1)
    return round_pack(sign, 1085 - shift as i32, sig)
}

// ---------------------------------------------------------------------------
// Single precision

/// Rounds and packs an `f32`: `sig` has its leading bit at bit 30.
fn u32 round_pack32(u64 sign, i32 exp0, u64 sig0) {
    var exp = exp0
    var sig = sig0
    var round_bits = sig & 0x7F
    if exp < 0 or exp >= 0xFD {
        if exp < 0 {
            sig = shift_right_jam(sig, (0 - exp) as u32)
            exp = 0
            round_bits = sig & 0x7F
        } else if exp > 0xFD or sig + 0x40 >= 0x8000_0000 {
            return ((sign << 31) | 0x7F80_0000) as u32
        }
    }
    sig = (sig + 0x40) >> 7
    if round_bits == 0x40 {
        sig &= 0xFFFF_FFFF_FFFF_FFFE
    }
    if sig == 0 {
        exp = 0
    }
    return ((sign << 31) +% ((exp as u64) << 23) +% sig) as u32
}

pub fn u64 f32_to_f64(u32 a) {
    let sign = (a >> 31) as u64
    let exp = ((a >> 23) & 0xFF) as i32
    var frac = (a & 0x7F_FFFF) as u64
    if exp == 0xFF {
        if frac != 0 {
            return (sign << 63) | QUIET_NAN | (frac << 29)
        }
        return pack(sign, 0x7FF, 0)
    }
    if exp == 0 {
        if frac == 0 {
            return pack(sign, 0, 0)
        }
        // Subnormal f32: normalize (every f32 is a normal f64).
        let shift = frac.leading_zeros() as i32 - 40
        frac = (frac << (shift as u64)) & 0x7F_FFFF
        return pack(sign, (1 - shift + 1023 - 127) as u64, frac << 29)
    }
    return pack(sign, (exp + 1023 - 127) as u64, frac << 29)
}

pub fn u32 f64_to_f32(u64 a) {
    let sign = a >> 63
    let exp = exp_of(a)
    let frac = a & FRAC
    if exp == 0x7FF {
        if frac != 0 {
            return ((sign << 31) | 0x7FC0_0000 | (frac >> 29)) as u32
        }
        return ((sign << 31) | 0x7F80_0000) as u32
    }
    let frac32 = shift_right_jam(frac, 22)
    if exp == 0 and frac32 == 0 {
        return (sign << 31) as u32
    }
    return round_pack32(sign, exp - 0x381, frac32 | 0x4000_0000)
}

fn u32 f32_from_magnitude(u64 sign, u64 mag) {
    if mag == 0 {
        return (sign << 31) as u32
    }
    let shift = mag.leading_zeros()
    let sig = shift_right_jam(mag << (shift as u64), 33)
    return round_pack32(sign, 189 - shift as i32, sig)
}

fn u32 f32_bits(f32 x) {
    return x.to_bits()
}

fn f32 f32_float(u32 b) {
    return math.f32_from_bits(b)
}

/// An `f32` operation computed in `f64`, rounded once.
fn f32 f32_via_f64(f32 a, f32 b, i32 op) {
    let x = f32_to_f64(f32_bits(a))
    let y = f32_to_f64(f32_bits(b))
    let r = when op {
        0 then f64_add(x, y)
        1 then f64_sub(x, y)
        2 then f64_mul(x, y)
        _ then f64_div(x, y)
    }
    return f32_float(f64_to_f32(r))
}

// ---------------------------------------------------------------------------
// The functions called by LLVM (soft-float targets only)

@cfg("soft_float")
@export("__adddf3")
pub fn f64 adddf3(f64 a, f64 b) {
    return float(f64_add(bits(a), bits(b)))
}

@cfg("soft_float")
@export("__subdf3")
pub fn f64 subdf3(f64 a, f64 b) {
    return float(f64_sub(bits(a), bits(b)))
}

@cfg("soft_float")
@export("__muldf3")
pub fn f64 muldf3(f64 a, f64 b) {
    return float(f64_mul(bits(a), bits(b)))
}

@cfg("soft_float")
@export("__divdf3")
pub fn f64 divdf3(f64 a, f64 b) {
    return float(f64_div(bits(a), bits(b)))
}

@cfg("soft_float")
@export("__negdf2")
pub fn f64 negdf2(f64 a) {
    return float(bits(a) ^ SIGN)
}

@cfg("soft_float")
@export("sqrt")
pub fn f64 sqrt(f64 a) {
    return float(f64_sqrt(bits(a)))
}

@cfg("soft_float")
@export("fmin")
pub fn f64 fmin(f64 a, f64 b) {
    let (x, y) = (bits(a), bits(b))
    if is_nan(x) {
        return b
    }
    if is_nan(y) {
        return a
    }
    return if f64_compare(x, y) < 0 { a } else { b }
}

@cfg("soft_float")
@export("fmax")
pub fn f64 fmax(f64 a, f64 b) {
    let (x, y) = (bits(a), bits(b))
    if is_nan(x) {
        return b
    }
    if is_nan(y) {
        return a
    }
    return if f64_compare(x, y) > 0 { a } else { b }
}

// Comparisons: the result's sign tells the order; NaN gives the value that makes the
// comparison false.

@cfg("soft_float")
@export("__eqdf2")
pub fn i32 eqdf2(f64 a, f64 b) {
    return if f64_compare(bits(a), bits(b)) == 0 { 0 } else { 1 }
}

@cfg("soft_float")
@export("__nedf2")
pub fn i32 nedf2(f64 a, f64 b) {
    return if f64_compare(bits(a), bits(b)) == 0 { 0 } else { 1 }
}

@cfg("soft_float")
@export("__ltdf2")
pub fn i32 ltdf2(f64 a, f64 b) {
    let c = f64_compare(bits(a), bits(b))
    return if c == 2 { 1 } else { c }
}

@cfg("soft_float")
@export("__ledf2")
pub fn i32 ledf2(f64 a, f64 b) {
    let c = f64_compare(bits(a), bits(b))
    return if c == 2 { 1 } else { c }
}

@cfg("soft_float")
@export("__cmpdf2")
pub fn i32 cmpdf2(f64 a, f64 b) {
    let c = f64_compare(bits(a), bits(b))
    return if c == 2 { 1 } else { c }
}

@cfg("soft_float")
@export("__gtdf2")
pub fn i32 gtdf2(f64 a, f64 b) {
    let c = f64_compare(bits(a), bits(b))
    return if c == 2 { -1 } else { c }
}

@cfg("soft_float")
@export("__gedf2")
pub fn i32 gedf2(f64 a, f64 b) {
    let c = f64_compare(bits(a), bits(b))
    return if c == 2 { -1 } else { c }
}

@cfg("soft_float")
@export("__unorddf2")
pub fn i32 unorddf2(f64 a, f64 b) {
    return if f64_compare(bits(a), bits(b)) == 2 { 1 } else { 0 }
}

// Conversions.

@cfg("soft_float")
@export("__fixdfsi")
pub fn i32 fixdfsi(f64 a) {
    let v = f64_to_int(bits(a), 32, true)
    let low = v & 0xFFFF_FFFF
    if low >= 0x8000_0000 {
        return ((low as i64) - 0x1_0000_0000) as i32
    }
    return low as i32
}

@cfg("soft_float")
@export("__fixunsdfsi")
pub fn u32 fixunsdfsi(f64 a) {
    return (f64_to_int(bits(a), 32, false) & 0xFFFF_FFFF) as u32
}

@cfg("soft_float")
@export("__fixdfdi")
pub fn i64 fixdfdi(f64 a) {
    let v = f64_to_int(bits(a), 64, true)
    if v >= SIGN {
        return 0 - ((0 -% v) - 1) as i64 - 1
    }
    return v as i64
}

@cfg("soft_float")
@export("__fixunsdfdi")
pub fn u64 fixunsdfdi(f64 a) {
    return f64_to_int(bits(a), 64, false)
}

@cfg("soft_float")
@export("__floatsidf")
pub fn f64 floatsidf(i32 a) {
    if a < 0 {
        return float(f64_from_magnitude(1, ((0 - (a as i64)) as u64)))
    }
    return float(f64_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatunsidf")
pub fn f64 floatunsidf(u32 a) {
    return float(f64_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatdidf")
pub fn f64 floatdidf(i64 a) {
    if a < 0 {
        return float(f64_from_magnitude(1, ((0 - (a + 1)) as u64) + 1))
    }
    return float(f64_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatundidf")
pub fn f64 floatundidf(u64 a) {
    return float(f64_from_magnitude(0, a))
}

@cfg("soft_float")
@export("__extendsfdf2")
pub fn f64 extendsfdf2(f32 a) {
    return float(f32_to_f64(f32_bits(a)))
}

@cfg("soft_float")
@export("__truncdfsf2")
pub fn f32 truncdfsf2(f64 a) {
    return f32_float(f64_to_f32(bits(a)))
}

// Single precision (processors without any floating-point unit).

@cfg("soft_float")
@export("__addsf3")
pub fn f32 addsf3(f32 a, f32 b) {
    return f32_via_f64(a, b, 0)
}

@cfg("soft_float")
@export("__subsf3")
pub fn f32 subsf3(f32 a, f32 b) {
    return f32_via_f64(a, b, 1)
}

@cfg("soft_float")
@export("__mulsf3")
pub fn f32 mulsf3(f32 a, f32 b) {
    return f32_via_f64(a, b, 2)
}

@cfg("soft_float")
@export("__divsf3")
pub fn f32 divsf3(f32 a, f32 b) {
    return f32_via_f64(a, b, 3)
}

@cfg("soft_float")
@export("__negsf2")
pub fn f32 negsf2(f32 a) {
    return f32_float(f32_bits(a) ^ 0x8000_0000)
}

@cfg("soft_float")
@export("sqrtf")
pub fn f32 sqrtf(f32 a) {
    return f32_float(f64_to_f32(f64_sqrt(f32_to_f64(f32_bits(a)))))
}

fn i32 f32_compare(f32 a, f32 b) {
    return f64_compare(f32_to_f64(f32_bits(a)), f32_to_f64(f32_bits(b)))
}

@cfg("soft_float")
@export("__eqsf2")
pub fn i32 eqsf2(f32 a, f32 b) {
    return if f32_compare(a, b) == 0 { 0 } else { 1 }
}

@cfg("soft_float")
@export("__nesf2")
pub fn i32 nesf2(f32 a, f32 b) {
    return if f32_compare(a, b) == 0 { 0 } else { 1 }
}

@cfg("soft_float")
@export("__ltsf2")
pub fn i32 ltsf2(f32 a, f32 b) {
    let c = f32_compare(a, b)
    return if c == 2 { 1 } else { c }
}

@cfg("soft_float")
@export("__lesf2")
pub fn i32 lesf2(f32 a, f32 b) {
    let c = f32_compare(a, b)
    return if c == 2 { 1 } else { c }
}

@cfg("soft_float")
@export("__gtsf2")
pub fn i32 gtsf2(f32 a, f32 b) {
    let c = f32_compare(a, b)
    return if c == 2 { -1 } else { c }
}

@cfg("soft_float")
@export("__gesf2")
pub fn i32 gesf2(f32 a, f32 b) {
    let c = f32_compare(a, b)
    return if c == 2 { -1 } else { c }
}

@cfg("soft_float")
@export("__unordsf2")
pub fn i32 unordsf2(f32 a, f32 b) {
    return if f32_compare(a, b) == 2 { 1 } else { 0 }
}

@cfg("soft_float")
@export("__fixsfsi")
pub fn i32 fixsfsi(f32 a) {
    return fixdfsi(extendsfdf2(a))
}

@cfg("soft_float")
@export("__fixunssfsi")
pub fn u32 fixunssfsi(f32 a) {
    return fixunsdfsi(extendsfdf2(a))
}

@cfg("soft_float")
@export("__fixsfdi")
pub fn i64 fixsfdi(f32 a) {
    return fixdfdi(extendsfdf2(a))
}

@cfg("soft_float")
@export("__fixunssfdi")
pub fn u64 fixunssfdi(f32 a) {
    return fixunsdfdi(extendsfdf2(a))
}

@cfg("soft_float")
@export("__floatsisf")
pub fn f32 floatsisf(i32 a) {
    if a < 0 {
        return f32_float(f32_from_magnitude(1, (0 - (a as i64)) as u64))
    }
    return f32_float(f32_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatunsisf")
pub fn f32 floatunsisf(u32 a) {
    return f32_float(f32_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatdisf")
pub fn f32 floatdisf(i64 a) {
    if a < 0 {
        return f32_float(f32_from_magnitude(1, ((0 - (a + 1)) as u64) + 1))
    }
    return f32_float(f32_from_magnitude(0, a as u64))
}

@cfg("soft_float")
@export("__floatundisf")
pub fn f32 floatundisf(u64 a) {
    return f32_float(f32_from_magnitude(0, a))
}
