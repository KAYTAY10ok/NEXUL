/// Internal single-threaded Wasm page allocator, shared by WASI and web.
import std.mem

@intrinsic
unsafe fn wasm_memory_grow(pages: usize) -> isize

const PAGE: usize = 65536

/// Freed large regions, reused first (linear memory cannot shrink): each region starts
/// with [size, next].
static var FREE_REGIONS: Ptr[u8] = Ptr.null()

pub unsafe fn page_alloc(size: usize) -> Ptr[u8] {
    // First fit among the freed regions.
    var prev: Ptr[u8] = Ptr.null()
    var r = FREE_REGIONS
    while not r.is_null() {
        let rsize = r.cast[usize]().read()
        let next = r.offset(4).cast[Ptr[u8]]().read()
        if rsize >= size {
            if prev.is_null() {
                FREE_REGIONS = next
            } else {
                prev.offset(4).cast[Ptr[u8]]().write(next)
            }
            mem.set_bytes(r, 0, size)
            return r
        }
        prev = r
        r = next
    }
    let pages = (size + PAGE - 1) / PAGE
    let old = wasm_memory_grow(pages)
    if old < 0 {
        return Ptr.null()
    }
    return Ptr[u8].from_addr((old as usize) * PAGE)
}

pub unsafe fn page_free(p: Ptr[u8], size: usize) {
    p.cast[usize]().write(size)
    p.offset(4).cast[Ptr[u8]]().write(FREE_REGIONS)
    FREE_REGIONS = p
}
