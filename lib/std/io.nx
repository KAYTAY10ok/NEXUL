// edition: 1
/// Standard input/output and files (spec chapter 09).

import std.sys
import std.rt
import std.string

/// Flushes the standard output.
pub fn flush() {
    rt.flush()
}

/// Reads one line from the standard input, without its line terminator.
/// Returns `None` at the end of the input.
pub fn Option[String] read_line() {
    var line = String.new()
    if sys.read_line(line!) {
        return Some(line)
    }
    return None
}

/// Why an input/output operation failed (ADR 0015). The variants keep the path given
/// to the function; `Other` keeps the system's error code.
@derive(Eq, Clone)
pub type IoError =
    /// Nothing exists at this path.
    | .NotFound(String)
    /// The system refuses access to this path.
    | .PermissionDenied(String)
    /// Something already exists at this path.
    | .AlreadyExists(String)
    /// The content is not what was expected (a text file that is not UTF-8).
    | .InvalidData(String)
    /// A signal interrupted the operation.
    | .Interrupted
    /// Another error: the system's code (-1 when the system gives none) and a message.
    | .Other(i32, String)

extend IoError is Display {
    fn String to_string(self) {
        return when self {
            .NotFound(path) then "file not found: {path}"
            .PermissionDenied(path) then "permission denied: {path}"
            .AlreadyExists(path) then "file already exists: {path}"
            .InvalidData(detail) then "invalid data: {detail}"
            .Interrupted then "operation interrupted"
            .Other(code, message) then "{message} (os error {code})"
        }
    }
}

extend IoError is Error {
}

/// The error for a code returned by `sys.read_file` or `sys.write_file`.
fn IoError io_error(i32 code, owned String path, String action) {
    return when sys.io_error_kind(code) {
        1 then IoError.NotFound(path)
        2 then IoError.PermissionDenied(path)
        3 then IoError.AlreadyExists(path)
        4 then IoError.Interrupted
        _ then IoError.Other(code, "cannot {action} file: {path}")
    }
}

/// Reads a whole file as bytes.
pub fn Result[Vec[u8], IoError] read_bytes(String path) {
    var Vec[u8] bytes = Vec.new()
    let code = sys.read_file(path, bytes!)
    if code != 0 {
        return Err(io_error(code, path.clone(), "read"))
    }
    return Ok(bytes)
}

/// Reads a whole UTF-8 text file.
pub fn Result[String, IoError] read_file(String path) {
    var Vec[u8] bytes = Vec.new()
    let code = sys.read_file(path, bytes!)
    if code != 0 {
        return Err(io_error(code, path.clone(), "read"))
    }
    if not unsafe { string.utf8_valid(bytes.as_ptr(), bytes.len()) } {
        return Err(IoError.InvalidData("file is not valid UTF-8: {path}"))
    }
    unsafe {
        let (data, len, cap) = bytes.into_raw_parts()
        return Ok(String.from_raw_parts(data, len, cap))
    }
}

/// Creates or replaces a file with `content`.
pub fn Result[(), IoError] write_file(String path, String content) {
    let code = sys.write_file(path, content.as_ptr(), content.len(), false)
    if code != 0 {
        return Err(io_error(code, path.clone(), "write"))
    }
    return Ok(())
}

/// Creates or replaces a file with raw bytes.
pub fn Result[(), IoError] write_bytes(String path, Vec[u8] content) {
    let code = sys.write_file(path, content.as_ptr(), content.len(), false)
    if code != 0 {
        return Err(io_error(code, path.clone(), "write"))
    }
    return Ok(())
}

/// Appends `content` at the end of a file (created if needed).
pub fn Result[(), IoError] append_file(String path, String content) {
    let code = sys.write_file(path, content.as_ptr(), content.len(), true)
    if code != 0 {
        return Err(io_error(code, path.clone(), "write"))
    }
    return Ok(())
}
