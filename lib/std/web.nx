// edition: 1
/// Raw byte-buffer ABI for wasm32-web. Loaded automatically for this target.
/// Allocations belong to the host until freed exactly once with nx_free.
/// No String/Vec representation is exposed across the boundary.
import std.mem
import std.rt

@cfg("web")
@export("nx_abi_version")
pub fn i32 abi_version() { return 1 }

@cfg("web")
@export("nx_alloc")
pub unsafe fn Ptr[u8] alloc(usize len) { return mem.alloc(len) }

/// The pointer must be null or a live allocation returned by nx_alloc.
@cfg("web")
@export("nx_free")
pub unsafe fn free(Ptr[u8] p) { mem.free(p) }

@cfg("web")
@export("nx_flush")
pub fn flush() { rt.flush() }
