// edition: 1
/// Interface with the operating system (spec chapter 09).

import std.sys
import std.rt

/// Ends the program immediately with an exit code (0 means success). The standard
/// output is flushed first.
pub fn Never exit(i32 code) {
    rt.exit(code)
}

/// The command-line arguments; the first one is the program name.
pub fn Vec[String] args() {
    var Vec[String] all = Vec.new()
    for i in 0..sys.arg_count() {
        all.push(sys.arg(i))
    }
    return all
}

/// The value of an environment variable.
pub fn Option[String] env(String name) {
    return sys.env(name)
}
