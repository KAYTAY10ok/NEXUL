// edition: 1
/// System layer for Windows (spec §5.3).
///
/// Only `kernel32.dll` (and `bcrypt.dll` for random numbers) is used: no C runtime.
/// Text crosses the system boundary in UTF-16; NEXUL strings are UTF-8.

import std.mem
import std.rt

// ---------------------------------------------------------------------------
// Windows API

@link("kernel32")
extern "C" fn Ptr[u8] GetStdHandle(u32 id)
@link("kernel32")
extern "C" fn i32 WriteFile(Ptr[u8] h, Ptr[u8] buffer, u32 length, Ptr[u32] written, Ptr[u8] overlapped)
@link("kernel32")
extern "C" fn i32 ReadFile(Ptr[u8] h, Ptr[u8] buffer, u32 length, Ptr[u32] read, Ptr[u8] overlapped)
@link("kernel32")
extern "C" fn i32 WriteConsoleW(Ptr[u8] h, Ptr[u16] buffer, u32 length, Ptr[u32] written, Ptr[u8] reserved)
@link("kernel32")
extern "C" fn i32 ReadConsoleW(Ptr[u8] h, Ptr[u16] buffer, u32 length, Ptr[u32] read, Ptr[u8] control)
@link("kernel32")
extern "C" fn i32 GetConsoleMode(Ptr[u8] h, Ptr[u32] mode)
@link("kernel32")
extern "C" fn i32 SetConsoleOutputCP(u32 code_page)
@link("kernel32")
extern "C" fn Never ExitProcess(u32 code)
@link("kernel32")
extern "C" fn Ptr[u8] AddVectoredExceptionHandler(u32 first, Ptr[u8] handler)
@link("kernel32")
extern "C" fn i32 SetThreadStackGuarantee(Ptr[u32] bytes)
@link("kernel32")
extern "C" fn Ptr[u8] GetProcessHeap()
@link("kernel32")
extern "C" fn Ptr[u8] HeapAlloc(Ptr[u8] heap, u32 flags, usize size)
@link("kernel32")
extern "C" fn Ptr[u8] HeapReAlloc(Ptr[u8] heap, u32 flags, Ptr[u8] p, usize size)
@link("kernel32")
extern "C" fn i32 HeapFree(Ptr[u8] heap, u32 flags, Ptr[u8] p)
@link("kernel32")
extern "C" fn Ptr[u16] GetCommandLineW()
@link("kernel32")
extern "C" fn u32 GetEnvironmentVariableW(Ptr[u16] name, Ptr[u16] buffer, u32 size)
@link("kernel32")
extern "C" fn u32 GetLastError()
@link("kernel32")
extern "C" fn Ptr[u8] CreateFileW(Ptr[u16] name, u32 access, u32 share, Ptr[u8] security, u32 disposition, u32 flags, Ptr[u8] template)
@link("kernel32")
extern "C" fn i32 CloseHandle(Ptr[u8] h)
@link("kernel32")
extern "C" fn i32 QueryPerformanceCounter(Ptr[i64] counter)
@link("kernel32")
extern "C" fn i32 QueryPerformanceFrequency(Ptr[i64] frequency)
@link("kernel32")
extern "C" fn GetSystemTimePreciseAsFileTime(Ptr[u64] time)
@link("kernel32")
extern "C" fn i32 FileTimeToSystemTime(Ptr[u64] file_time, Ptr[u16] system_time)
@link("kernel32")
extern "C" fn i32 SystemTimeToFileTime(Ptr[u16] system_time, Ptr[u64] file_time)
@link("kernel32")
extern "C" fn i32 SystemTimeToTzSpecificLocalTime(Ptr[u8] zone, Ptr[u16] utc, Ptr[u16] local)
@link("kernel32")
extern "C" fn Ptr[u8] CreateWaitableTimerExW(Ptr[u8] attributes, Ptr[u16] name, u32 flags, u32 access)
@link("kernel32")
extern "C" fn i32 SetWaitableTimer(Ptr[u8] timer, Ptr[i64] due, i32 period, Ptr[u8] routine, Ptr[u8] argument, i32 resume)
@link("kernel32")
extern "C" fn u32 WaitForSingleObject(Ptr[u8] h, u32 milliseconds)
@link("kernel32")
extern "C" fn Sleep(u32 milliseconds)
@link("bcrypt")
extern "C" fn i32 BCryptGenRandom(Ptr[u8] algorithm, Ptr[u8] buffer, u32 length, u32 flags)

const u32 STD_INPUT = 0xFFFF_FFF6
const u32 STD_OUTPUT = 0xFFFF_FFF5
const u32 STD_ERROR = 0xFFFF_FFF4
const u32 CP_UTF8 = 65001

// ---------------------------------------------------------------------------
// Process

static var Ptr[u8] HEAP = Ptr.null()
static var bool STDOUT_CONSOLE = false
static var bool STDERR_CONSOLE = false

/// The generated entry installs this before entering any NEXUL user code. The
/// reserved stack is only used to print and terminate; execution never resumes.
@lang("sys_set_fault_handler")
fn set_fault_handler(Ptr[u8] handler) {
    unsafe {
        var u32 bytes = 65536
        if SetThreadStackGuarantee(mem.addr_of(bytes!)) == 0 {
            exit(101)
        }
        if AddVectoredExceptionHandler(1, handler).is_null() {
            exit(101)
        }
    }
}

/// Minimal output path for an exhausted stack: no UTF-16 conversion, allocation
/// or shared console carry state. Both buffers remain valid until ExitProcess.
pub unsafe fn write_fault(i32 fd, Ptr[u8] data, usize len) {
    let h = GetStdHandle(if fd == 1 { STD_OUTPUT } else { STD_ERROR })
    var usize offset = 0
    while offset < len {
        var u32 written = 0
        let n = if len - offset > 0xFFFF_FFFF { 0xFFFF_FFFF } else { (len - offset) as u32 }
        if WriteFile(h, data.offset(offset), n, mem.addr_of(written!), Ptr.null()) == 0 or written == 0 {
            return
        }
        offset += written as usize
    }
}

@lang("sys_fault")
fn i32 fault(Ptr[u8] exception) {
    unsafe {
        // Windows supplies EXCEPTION_POINTERS: its first field points to an
        // EXCEPTION_RECORD, whose first field is the 32-bit exception code.
        let record = exception.cast[Ptr[u8]]().read()
        if record.cast[u32]().read() != 0xC000_00FD {
            return 0 // EXCEPTION_CONTINUE_SEARCH: do not swallow other faults.
        }
        rt.flush_stack_overflow()
        let msg = "panic: stack overflow (the recursion is probably too deep)\n"
        write_fault(2, msg.as_ptr(), msg.len())
        ExitProcess(101)
    }
}

unsafe fn bool is_console(Ptr[u8] h) {
    var u32 mode = 0
    return GetConsoleMode(h, mem.addr_of(mode!)) != 0
}

/// Called once at program start.
pub fn init() {
    unsafe {
        let _ = heap()
        let _ = SetConsoleOutputCP(CP_UTF8)
        STDOUT_CONSOLE = is_console(GetStdHandle(STD_OUTPUT))
        STDERR_CONSOLE = is_console(GetStdHandle(STD_ERROR))
    }
}

pub fn bool stdout_is_terminal() {
    return unsafe { STDOUT_CONSOLE }
}

/// The exit code as the unsigned value Windows expects.
fn u32 code_bits(i32 code) {
    if code < 0 {
        return ((code as i64) + 0x1_0000_0000) as u32
    }
    return code as u32
}

pub fn Never exit(i32 code) {
    unsafe {
        ExitProcess(code_bits(code))
    }
}

// ---------------------------------------------------------------------------
// Heap

unsafe fn Ptr[u8] heap() {
    if HEAP.is_null() {
        HEAP = GetProcessHeap()
    }
    return HEAP
}

/// Allocates `size` bytes aligned on 16 bytes; null if the memory is exhausted.
pub unsafe fn Ptr[u8] heap_alloc(usize size) {
    return HeapAlloc(heap(), 0, size)
}

pub unsafe fn Ptr[u8] heap_realloc(Ptr[u8] p, usize size) {
    return HeapReAlloc(heap(), 0, p, size)
}

pub unsafe fn heap_free(Ptr[u8] p) {
    let _ = HeapFree(heap(), 0, p)
}

// ---------------------------------------------------------------------------
// UTF-16

/// `s` as UTF-16, followed by a zero (for the `...W` functions).
fn Vec[u16] to_wide(String s) {
    var Vec[u16] w = Vec.with_capacity(s.len() + 1)
    for c in s {
        let v = c as u32
        if v >= 0x10000 {
            let u = v - 0x10000
            w.push((0xD800 + (u >> 10)) as u16)
            w.push((0xDC00 + (u & 0x3FF)) as u16)
        } else {
            w.push(v as u16)
        }
    }
    w.push(0)
    return w
}

/// The UTF-16 text `p[0..n]` as a string (unpaired surrogates become U+FFFD).
unsafe fn String from_wide(Ptr[u16] p, usize n) {
    var s = String.with_capacity(n)
    var usize i = 0
    while i < n {
        let u = p.offset(i).read() as u32
        i += 1
        if u >= 0xD800 and u <= 0xDBFF and i < n {
            let low = p.offset(i).read() as u32
            if low >= 0xDC00 and low <= 0xDFFF {
                i += 1
                s.push((0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00)) as char)
                continue
            }
        }
        if u >= 0xD800 and u <= 0xDFFF {
            s.push('\u{FFFD}')
        } else {
            s.push(u as char)
        }
    }
    return s
}

unsafe fn usize wide_len(Ptr[u16] p) {
    var usize n = 0
    while p.offset(n).read() != 0 {
        n += 1
    }
    return n
}

// ---------------------------------------------------------------------------
// Standard input and output

/// Bytes of an incomplete UTF-8 sequence left at the end of the last console write.
static var [u8; 4] CARRY = [0; 4]
static var usize CARRY_LEN = 0

/// Writes UTF-8 to a console as UTF-16 (the console does not reliably decode UTF-8
/// split across writes).
unsafe fn bool write_console(Ptr[u8] h, Ptr[u8] data, usize len) {
    var [u16; 1024] wide = [0; 1024]
    var usize n = 0
    var usize i = 0
    let total = CARRY_LEN + len
    while i < total {
        // Decode one UTF-8 sequence, reading the carried bytes first.
        let b0 = byte_at(data, i) as u32
        var usize need = 1
        var u32 cp = b0
        if b0 >= 0xF0 {
            need = 4
            cp = b0 & 0x07
        } else if b0 >= 0xE0 {
            need = 3
            cp = b0 & 0x0F
        } else if b0 >= 0xC0 {
            need = 2
            cp = b0 & 0x1F
        } else if b0 >= 0x80 {
            cp = 0xFFFD
        }
        if i + need > total {
            // Incomplete at the end: keep it for the next write.
            var usize k = 0
            while i + k < total {
                let b = byte_at(data, i + k)
                CARRY[k] = b
                k += 1
            }
            CARRY_LEN = k
            break
        }
        for k in 1..need {
            cp = (cp << 6) | (byte_at(data, i + k) as u32 & 0x3F)
        }
        i += need
        if cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) {
            cp = 0xFFFD
        }
        if cp >= 0x10000 {
            wide[n] = (0xD800 + ((cp - 0x10000) >> 10)) as u16
            wide[n + 1] = (0xDC00 + ((cp - 0x10000) & 0x3FF)) as u16
            n += 2
        } else {
            wide[n] = cp as u16
            n += 1
        }
        if n >= 1020 {
            if not flush_wide(h, mem.addr_of(wide!).cast[u16](), n) {
                return false
            }
            n = 0
        }
        if i == total {
            CARRY_LEN = 0
        }
    }
    if total == 0 or i == total {
        CARRY_LEN = 0
    }
    return flush_wide(h, mem.addr_of(wide!).cast[u16](), n)
}

/// Byte `i` of the carried bytes followed by `data`.
unsafe fn u8 byte_at(Ptr[u8] data, usize i) {
    if i < CARRY_LEN {
        return CARRY[i]
    }
    return data.offset(i - CARRY_LEN).read()
}

unsafe fn bool flush_wide(Ptr[u8] h, Ptr[u16] p, usize n) {
    var usize done = 0
    while done < n {
        var u32 written = 0
        if WriteConsoleW(h, p.offset(done), (n - done) as u32, mem.addr_of(written!), Ptr.null()) == 0 or written == 0 {
            return false
        }
        done += written as usize
    }
    return true
}

/// Writes bytes to standard output (`fd` 1) or standard error (`fd` 2).
pub unsafe fn bool write(i32 fd, Ptr[u8] data, usize len) {
    let h = GetStdHandle(if fd == 2 { STD_ERROR } else { STD_OUTPUT })
    if (fd == 2 and STDERR_CONSOLE) or (fd != 2 and STDOUT_CONSOLE) {
        return write_console(h, data, len)
    }
    return write_handle(h, data, len)
}

unsafe fn bool write_handle(Ptr[u8] h, Ptr[u8] data, usize len) {
    var usize done = 0
    while done < len {
        let chunk = if len - done > 0x4000_0000 { 0x4000_0000 } else { len - done }
        var u32 written = 0
        if WriteFile(h, data.offset(done), chunk as u32, mem.addr_of(written!), Ptr.null()) == 0 or written == 0 {
            return false
        }
        done += written as usize
    }
    return true
}

static var [u8; 4096] IN_BUF = [0; 4096]
static var usize IN_POS = 0
static var usize IN_LEN = 0

/// Next byte of the (redirected) standard input, or -1 at the end.
unsafe fn i32 read_byte(Ptr[u8] h) {
    if IN_POS == IN_LEN {
        var u32 got = 0
        if ReadFile(h, mem.addr_of(IN_BUF!).cast[u8](), 4096, mem.addr_of(got!), Ptr.null()) == 0 or got == 0 {
            return -1
        }
        IN_POS = 0
        IN_LEN = got as usize
    }
    let b = IN_BUF[IN_POS]
    IN_POS += 1
    return b as i32
}

/// Reads one line of standard input without its terminator; `false` at the end.
pub fn bool read_line(String out!) {
    let _input = unsafe { input_lock() }
    rt.flush()
    unsafe {
        let h = GetStdHandle(STD_INPUT)
        if is_console(h) {
            // UTF-16 from the console, one code unit at a time.
            var Vec[u16] units = Vec.new()
            var any_ = false
            loop {
                var u16 c = 0
                var u32 got = 0
                if ReadConsoleW(h, mem.addr_of(c!), 1, mem.addr_of(got!), Ptr.null()) == 0 or got == 0 {
                    break
                }
                any_ = true
                if c == 10 {
                    break
                }
                units.push(c)
            }
            if units.len() > 0 and units[units.len() - 1] == 13 {
                let _ = units.pop()
            }
            // Ctrl+Z at the start of a line ends the input.
            if not any_ or (units.len() > 0 and units[0] == 0x1A) {
                return false
            }
            out = from_wide(units.as_ptr(), units.len())
            return true
        }
        var Vec[u8] bytes = Vec.new()
        var any_ = false
        loop {
            let b = read_byte(h)
            if b < 0 {
                break
            }
            any_ = true
            if b == 10 {
                break
            }
            bytes.push(b as u8)
        }
        if not any_ {
            return false
        }
        if bytes.len() > 0 and bytes[bytes.len() - 1] == 13 {
            let _ = bytes.pop()
        }
        out = String.from_bytes_lossy(bytes.as_ptr(), bytes.len())
        return true
    }
}

// ---------------------------------------------------------------------------
// Command line and environment

/// The command line split into arguments with the rules of the Microsoft C runtime.
fn Vec[String] command_line() {
    var Vec[String] args = Vec.new()
    unsafe {
        let p = GetCommandLineW()
        let n = wide_len(p)
        var usize i = 0
        // The program name: up to the closing quote, or up to the first blank.
        var Vec[u16] name = Vec.new()
        if n > 0 and p.read() == 34 {
            i = 1
            while i < n and p.offset(i).read() != 34 {
                name.push(p.offset(i).read())
                i += 1
            }
            if i < n {
                i += 1
            }
        } else {
            while i < n and p.offset(i).read() != 32 and p.offset(i).read() != 9 {
                name.push(p.offset(i).read())
                i += 1
            }
        }
        args.push(from_wide(name.as_ptr(), name.len()))
        loop {
            while i < n and (p.offset(i).read() == 32 or p.offset(i).read() == 9) {
                i += 1
            }
            if i >= n {
                break
            }
            var Vec[u16] arg = Vec.new()
            var quoted = false
            while i < n {
                let c = p.offset(i).read()
                if (c == 32 or c == 9) and not quoted {
                    break
                }
                if c == 92 {
                    // Backslashes are literal unless they precede a quote.
                    var usize count = 0
                    while i < n and p.offset(i).read() == 92 {
                        count += 1
                        i += 1
                    }
                    if i < n and p.offset(i).read() == 34 {
                        for _ in 0..count / 2 {
                            arg.push(92)
                        }
                        if count % 2 == 1 {
                            arg.push(34)
                            i += 1
                        }
                    } else {
                        for _ in 0..count {
                            arg.push(92)
                        }
                    }
                    continue
                }
                if c == 34 {
                    if quoted and i + 1 < n and p.offset(i + 1).read() == 34 {
                        // `""` inside quotes is a literal quote.
                        arg.push(34)
                        i += 2
                        continue
                    }
                    quoted = not quoted
                    i += 1
                    continue
                }
                arg.push(c)
                i += 1
            }
            args.push(from_wide(arg.as_ptr(), arg.len()))
        }
    }
    return args
}

pub fn i32 arg_count() {
    return command_line().len() as i32
}

pub fn String arg(i32 index) {
    let all = command_line()
    if index < 0 or index as usize >= all.len() {
        panic("argument index {index} out of range")
    }
    return all[index as usize].clone()
}

pub fn Option[String] env(String name) {
    unsafe {
        let wname = to_wide(name)
        let size = GetEnvironmentVariableW(wname.as_ptr(), Ptr.null(), 0)
        if size == 0 {
            if GetLastError() == 203 {
                return None
            }
            return Some(String.new())
        }
        let buf = mem.alloc((size as usize) * 2).cast[u16]()
        let n = GetEnvironmentVariableW(wname.as_ptr(), buf, size)
        let value = from_wide(buf, n as usize)
        mem.free(buf.cast[u8]())
        return Some(value)
    }
}

pub fn bool env_is_set(String name) {
    return env(name).is_some()
}

// ---------------------------------------------------------------------------
// Files

const u32 GENERIC_READ = 0x8000_0000
const u32 GENERIC_WRITE = 0x4000_0000
const u32 FILE_APPEND_DATA = 0x0004

fn bool invalid(Ptr[u8] h) {
    return h.is_null() or h.addr() == usize.MAX
}

/// The code of the last failure of the calling thread (never 0: -1 if the system gave
/// none).
fn i32 last_error() {
    let code = unsafe { GetLastError() } as i32
    return if code == 0 { -1 } else { code }
}

/// Reads a whole file into `out` (bytes). Returns 0, or the error code (`GetLastError`).
pub fn i32 read_file(String path, Vec[u8] out!) {
    unsafe {
        let wpath = to_wide(path)
        let h = CreateFileW(wpath.as_ptr(), GENERIC_READ, 3, Ptr.null(), 3, 0x80, Ptr.null())
        if invalid(h) {
            return last_error()
        }
        var i32 code = 0
        loop {
            out.reserve(65536)
            var u32 got = 0
            if ReadFile(h, out.as_ptr().offset(out.len()), 65536, mem.addr_of(got!), Ptr.null()) == 0 {
                code = last_error()
                break
            }
            if got == 0 {
                break
            }
            out.set_len(out.len() + got as usize)
        }
        let _ = CloseHandle(h)
        return code
    }
}

/// Creates (or replaces, or appends to) a file. Returns 0, or the error code
/// (`GetLastError`).
pub fn i32 write_file(String path, Ptr[u8] data, usize len, bool append) {
    unsafe {
        let wpath = to_wide(path)
        let access = if append { FILE_APPEND_DATA } else { GENERIC_WRITE }
        let u32 disposition = if append { 4 } else { 2 }
        let h = CreateFileW(wpath.as_ptr(), access, 1, Ptr.null(), disposition, 0x80, Ptr.null())
        if invalid(h) {
            return last_error()
        }
        if not (len == 0 or write_handle(h, data, len)) {
            let code = last_error()
            let _ = CloseHandle(h)
            return code
        }
        if CloseHandle(h) == 0 {
            return last_error()
        }
        return 0
    }
}

/// The `std.io` category of an error code returned by `read_file` or `write_file`
/// (ADR 0015): 1 not found, 2 permission denied, 3 already exists, 4 interrupted,
/// 0 another error.
pub fn u8 io_error_kind(i32 code) {
    return when code {
        2 | 3 then 1 // ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND
        5 then 2 // ERROR_ACCESS_DENIED
        80 | 183 then 3 // ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS
        _ then 0
    }
}

// ---------------------------------------------------------------------------
// Time

pub fn u64 monotonic_ns() {
    var i64 counter = 0
    var i64 frequency = 0
    unsafe {
        let _ = QueryPerformanceCounter(mem.addr_of(counter!))
        let _ = QueryPerformanceFrequency(mem.addr_of(frequency!))
    }
    let c = counter as u64
    let f = frequency as u64
    return (c / f) * 1_000_000_000 + (c % f) * 1_000_000_000 / f
}

/// 100 ns intervals from 1601-01-01 to 1970-01-01.
const i64 EPOCH_DIFFERENCE = 116_444_736_000_000_000

pub fn i64 unix_time_ns() {
    var u64 ft = 0
    unsafe {
        GetSystemTimePreciseAsFileTime(mem.addr_of(ft!))
    }
    return ((ft as i64) - EPOCH_DIFFERENCE) * 100
}

/// Offset of local time from UTC at `unix_seconds`, in seconds (daylight saving time
/// included).
pub fn i32 utc_offset(i64 unix_seconds) {
    var ft = (unix_seconds * 10_000_000 + EPOCH_DIFFERENCE) as u64
    var [u16; 8] utc = [0; 8]
    var [u16; 8] local = [0; 8]
    var u64 local_ft = 0
    unsafe {
        if FileTimeToSystemTime(mem.addr_of(ft!), mem.addr_of(utc!).cast[u16]()) == 0 {
            return 0
        }
        if SystemTimeToTzSpecificLocalTime(Ptr.null(), mem.addr_of(utc!).cast[u16](), mem.addr_of(local!).cast[u16]()) == 0 {
            return 0
        }
        if SystemTimeToFileTime(mem.addr_of(local!).cast[u16](), mem.addr_of(local_ft!)) == 0 {
            return 0
        }
    }
    return (((local_ft as i64) - (ft as i64)) / 10_000_000) as i32
}

pub fn sleep_ns(u64 ns) {
    if ns == 0 {
        return
    }
    unsafe {
        // A high-resolution waitable timer is precise to well under a millisecond;
        // `Sleep` rounds up to the system tick (about 15.6 ms).
        let timer = CreateWaitableTimerExW(Ptr.null(), Ptr.null(), 2, 0x1F_0003)
        var left = ns
        while left > 0 {
            let chunk = if left > 86_400_000_000_000 { 86_400_000_000_000 } else { left }
            var due = 0 - ((chunk + 99) / 100) as i64
            if not timer.is_null() and SetWaitableTimer(timer, mem.addr_of(due!), 0, Ptr.null(), Ptr.null(), 0) != 0 {
                let _ = WaitForSingleObject(timer, 0xFFFF_FFFF)
            } else {
                Sleep(((chunk + 999_999) / 1_000_000) as u32)
            }
            left -= chunk
        }
        if not timer.is_null() {
            let _ = CloseHandle(timer)
        }
    }
}

// ---------------------------------------------------------------------------
// Random numbers

/// Fills `buffer` with cryptographically secure random bytes.
pub unsafe fn bool random_bytes(Ptr[u8] buffer, usize len) {
    var usize done = 0
    while done < len {
        let n = if len - done > 0x4000_0000 { 0x4000_0000 } else { len - done }
        if BCryptGenRandom(Ptr.null(), buffer.offset(done), n as u32, 2) != 0 {
            return false
        }
        done += n
    }
    return true
}

// ---------------------------------------------------------------------------
// Threads (ADR 0013)

@link("kernel32")
extern "C" fn Ptr[u8] CreateThread(Ptr[u8] attributes, usize stack_size, fn u32(Ptr[u8]) start, Ptr[u8] parameter, u32 flags, Ptr[u32] id)
@link("kernel32")
extern "C" fn u32 GetCurrentThreadId()
@link("kernel32")
extern "C" fn i32 SwitchToThread()

/// STACK_SIZE_PARAM_IS_A_RESERVATION: the size reserves the stack (8 MiB, like Linux).
const u32 THREAD_STACK_RESERVE = 0x10000
const usize THREAD_STACK = 8_388_608

/// What a thread runs.
type ThreadStart {
    fn(Ptr[u8]) entry
    Ptr[u8] arg
}

/// Set (to 1) before the first thread starts: from then on the runtime locks.
static var u32 THREADED = 0

/// Starts a thread that runs `entry(arg)`; returns its handle, or 0 if it cannot (the
/// caller then runs `entry(arg)` itself).
pub unsafe fn usize thread_start(owned fn(Ptr[u8]) entry, Ptr[u8] arg) {
    mem.atomic_store(mem.addr_of(THREADED!), 1)
    let s = rt.alloc(mem.size_of[ThreadStart]()).cast[ThreadStart]()
    s.write(ThreadStart(entry: entry, arg: arg))
    let h = CreateThread(Ptr.null(), THREAD_STACK, thread_main, s.cast[u8](), THREAD_STACK_RESERVE, Ptr.null())
    if h.is_null() {
        rt.free(s.cast[u8]())
        return 0
    }
    return h.addr()
}

/// The first function of a thread (the start routine of `CreateThread`). The guarantee of
/// stack is per thread: without it, the handler of a stack overflow (C2) would have no
/// stack left to print its message.
fn u32 thread_main(Ptr[u8] arg) {
    unsafe {
        var u32 bytes = 65536
        let _ = SetThreadStackGuarantee(mem.addr_of(bytes!))
        let s = arg.cast[ThreadStart]().read()
        rt.free(arg)
        let entry = s.entry
        entry(s.arg)
    }
    return 0
}

/// Waits for the end of a thread started by `thread_start`.
pub unsafe fn thread_join(usize handle) {
    let h = Ptr[u8].from_addr(handle)
    let _ = WaitForSingleObject(h, 0xFFFF_FFFF)
    let _ = CloseHandle(h)
}

/// The id of the calling thread.
pub fn u64 thread_id() {
    return unsafe { GetCurrentThreadId() } as u64
}

/// Lets another thread run.
pub fn thread_yield() {
    let _ = unsafe { SwitchToThread() }
}

// ---------------------------------------------------------------------------
// Lock of the runtime (ADR 0013, task C5)
//
// The allocator and the outputs are shared by the threads: `rt.critical_section()` takes
// this lock. The runtime calls itself (`print` allocates), so the thread that holds the
// lock may take it again. Until the first thread starts, nothing is locked.

static var u64 RT_OWNER = 0
static var u32 RT_DEPTH = 0

pub type CriticalSection {
    bool locked
}

extend CriticalSection {
    fn drop(self!) {
        if self.locked {
            unsafe {
                RT_DEPTH -= 1
                if RT_DEPTH == 0 {
                    mem.atomic_store(mem.addr_of(RT_OWNER!), 0)
                }
            }
        }
    }
}

pub unsafe fn CriticalSection critical_section() {
    if mem.atomic_load(mem.addr_of(THREADED!)) == 0 {
        return CriticalSection(locked: false)
    }
    let me = thread_id() + 1
    if mem.atomic_load(mem.addr_of(RT_OWNER!)) != me {
        while mem.atomic_cas(mem.addr_of(RT_OWNER!), 0, me) != 0 {
            thread_yield()
        }
    }
    RT_DEPTH += 1
    return CriticalSection(locked: true)
}

/// The standard input is read by one thread at a time, with its own lock: a thread that
/// waits for a line does not hold the lock of the runtime.
static var u32 IN_LOCK = 0

type InputLock {
    bool locked
}

extend InputLock {
    fn drop(self!) {
        if self.locked {
            unsafe {
                mem.atomic_store(mem.addr_of(IN_LOCK!), 0)
            }
        }
    }
}

unsafe fn InputLock input_lock() {
    if mem.atomic_load(mem.addr_of(THREADED!)) == 0 {
        return InputLock(locked: false)
    }
    while mem.atomic_cas(mem.addr_of(IN_LOCK!), 0, 1) != 0 {
        thread_yield()
    }
    return InputLock(locked: true)
}

// The wait on an address of Windows 8 and later (the futex of Windows).
@link("api-ms-win-core-synch-l1-2-0")
extern "C" fn i32 WaitOnAddress(Ptr[u32] address, Ptr[u32] compare, usize size, u32 milliseconds)
@link("api-ms-win-core-synch-l1-2-0")
extern "C" fn WakeByAddressSingle(Ptr[u32] address)
@link("api-ms-win-core-synch-l1-2-0")
extern "C" fn WakeByAddressAll(Ptr[u32] address)

/// Sleeps while the word at `p` holds `expected` (a wake or a change of the word ends the
/// sleep; it may also end without reason: the caller checks again). Used by the channels
/// and the locks of `std.tache`.
pub unsafe fn wait_on(Ptr[u32] p, u32 expected) {
    var u32 e = expected
    let _ = WaitOnAddress(p, mem.addr_of(e!), 4, 0xFFFF_FFFF)
}

/// Wakes every thread sleeping in `wait_on` on the word at `p`.
pub unsafe fn wake_all(Ptr[u32] p) {
    WakeByAddressAll(p)
}

/// Wakes one of the threads sleeping in `wait_on` on the word at `p`.
pub unsafe fn wake_one(Ptr[u32] p) {
    WakeByAddressSingle(p)
}
