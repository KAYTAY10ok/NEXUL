/// Browser host ABI v1. No WASI, implicit files, environment or DOM access.
import std.heap
import std.wasm

@link("nexul_v1")
extern "C" fn nx_write(fd: i32, data: Ptr[u8], len: usize) -> i32
@link("nexul_v1")
extern "C" fn nx_exit(code: i32) -> Never
@link("nexul_v1")
extern "C" fn nx_now_ns(monotonic: i32) -> i64
@link("nexul_v1")
extern "C" fn nx_random(data: Ptr[u8], len: usize) -> i32

pub fn init() {}
pub fn stdout_is_terminal() -> bool { return true }
pub fn exit(code: i32) -> Never { unsafe { nx_exit(code) } }

pub unsafe fn page_alloc(size: usize) -> Ptr[u8] { return wasm.page_alloc(size) }
pub unsafe fn page_free(p: Ptr[u8], size: usize) { wasm.page_free(p, size) }
pub unsafe fn heap_alloc(size: usize) -> Ptr[u8] { return heap.alloc(size) }
pub unsafe fn heap_realloc(p: Ptr[u8], size: usize) -> Ptr[u8] { return heap.realloc(p, size) }
pub unsafe fn heap_free(p: Ptr[u8]) { heap.free(p) }

pub unsafe fn write(fd: i32, data: Ptr[u8], len: usize) -> bool {
    return nx_write(fd, data, len) == 0
}

pub fn read_line(inout out: String) -> bool { let _ = out; return false }
pub fn arg_count() -> i32 { return 0 }
pub fn arg(index: i32) -> String { panic("no command-line arguments on wasm32-web: {index}") }
pub fn env(name: String) -> Option[String] { let _ = name; return None }
pub fn env_is_set(name: String) -> bool { let _ = name; return false }
/// No file system on wasm32-web: always the error code -1.
pub fn read_file(path: String, inout out: Vec[u8]) -> i32 {
    let _ = path
    let _ = out
    return -1
}
pub fn write_file(path: String, data: Ptr[u8], len: usize, append: bool) -> i32 {
    let _ = path
    let _ = data
    let _ = len
    let _ = append
    return -1
}
pub fn io_error_kind(code: i32) -> u8 { let _ = code; return 0 }
pub fn monotonic_ns() -> u64 { return unsafe { nx_now_ns(1) } as u64 }
pub fn unix_time_ns() -> i64 { return unsafe { nx_now_ns(0) } }
pub fn utc_offset(unix_seconds: i64) -> i32 { let _ = unix_seconds; return 0 }
pub fn sleep_ns(ns: u64) {
    if ns != 0 { panic("blocking sleep is unavailable on wasm32-web; schedule from the host") }
}
pub unsafe fn random_bytes(buffer: Ptr[u8], len: usize) -> bool {
    return nx_random(buffer, len) == 0
}

/// The lock of the runtime (ADR 0013, task C5): nothing to lock on a target without
/// threads or interrupts.
pub struct CriticalSection {
    unused: bool
}

pub unsafe fn critical_section() -> CriticalSection {
    return CriticalSection(unused: false)
}

// ---------------------------------------------------------------------------
// Threads (ADR 0013): none on this target. `std.tache` runs each task when it is
// launched, which is one of the orders allowed by its rules.

/// Returns 0: the caller runs `entry(arg)` itself.
pub unsafe fn thread_start(owned entry: fn(Ptr[u8]), arg: Ptr[u8]) -> usize {
    let _ = entry
    let _ = arg
    return 0
}

pub unsafe fn thread_join(handle: usize) {
    let _ = handle
}

pub fn thread_id() -> u64 {
    return 0
}

pub fn thread_yield() {
}
