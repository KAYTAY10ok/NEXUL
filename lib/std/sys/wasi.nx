// edition: 1
/// System layer for WebAssembly with WASI (spec §5.3, §8.2).
///
/// The program imports the functions of `wasi_snapshot_preview1` from its host (a browser
/// runtime, Node.js, Wasmtime...). Memory grows by pages of 64 KiB; files are reached
/// through the directories the host grants (preopens).

import std.mem
import std.rt
import std.heap
import std.wasm

@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_write(i32 fd, Ptr[u8] iovs, i32 iovs_len, Ptr[i32] written)
@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_read(i32 fd, Ptr[u8] iovs, i32 iovs_len, Ptr[i32] read)
@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_close(i32 fd)
@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_fdstat_get(i32 fd, Ptr[u8] stat)
@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_prestat_get(i32 fd, Ptr[u8] prestat)
@link("wasi_snapshot_preview1")
extern "C" fn i32 fd_prestat_dir_name(i32 fd, Ptr[u8] path, i32 len)
@link("wasi_snapshot_preview1")
extern "C" fn i32 path_open(i32 dirfd, i32 dirflags, Ptr[u8] path, i32 path_len, i32 oflags, i64 rights_base, i64 rights_inheriting, i32 fdflags, Ptr[i32] fd)
@link("wasi_snapshot_preview1")
extern "C" fn i32 args_sizes_get(Ptr[i32] argc, Ptr[i32] buf_size)
@link("wasi_snapshot_preview1")
extern "C" fn i32 args_get(Ptr[Ptr[u8]] argv, Ptr[u8] buf)
@link("wasi_snapshot_preview1")
extern "C" fn i32 environ_sizes_get(Ptr[i32] count, Ptr[i32] buf_size)
@link("wasi_snapshot_preview1")
extern "C" fn i32 environ_get(Ptr[Ptr[u8]] env, Ptr[u8] buf)
@link("wasi_snapshot_preview1")
extern "C" fn i32 clock_time_get(i32 id, i64 precision, Ptr[i64] time)
@link("wasi_snapshot_preview1")
extern "C" fn i32 random_get(Ptr[u8] buf, i32 len)
@link("wasi_snapshot_preview1")
extern "C" fn i32 poll_oneoff(Ptr[u8] subscriptions, Ptr[u8] events, i32 count, Ptr[i32] nevents)
@link("wasi_snapshot_preview1")
extern "C" fn Never proc_exit(i32 code)

// ---------------------------------------------------------------------------
// Process

static var bool STDOUT_TERMINAL = false

unsafe fn bool is_terminal(i32 fd) {
    var [u8; 24] stat = [0; 24]
    if fd_fdstat_get(fd, mem.addr_of(stat!).cast[u8]()) != 0 {
        return false
    }
    // filetype 2: character device
    return stat[0] == 2
}

pub fn init() {
    unsafe {
        STDOUT_TERMINAL = is_terminal(1)
    }
}

pub fn bool stdout_is_terminal() {
    return unsafe { STDOUT_TERMINAL }
}

pub fn Never exit(i32 code) {
    unsafe {
        proc_exit(code)
    }
}

// ---------------------------------------------------------------------------
// Memory

pub unsafe fn Ptr[u8] page_alloc(usize size) { return wasm.page_alloc(size) }
pub unsafe fn page_free(Ptr[u8] p, usize size) { wasm.page_free(p, size) }

pub unsafe fn Ptr[u8] heap_alloc(usize size) {
    return heap.alloc(size)
}

pub unsafe fn Ptr[u8] heap_realloc(Ptr[u8] p, usize size) {
    return heap.realloc(p, size)
}

pub unsafe fn heap_free(Ptr[u8] p) {
    heap.free(p)
}

// ---------------------------------------------------------------------------
// Input and output

unsafe fn bool write_fd(i32 fd, Ptr[u8] data, usize len) {
    var usize done = 0
    while done < len {
        var [usize; 2] iov = [data.offset(done).addr(), len - done]
        var i32 written = 0
        if fd_write(fd, mem.addr_of(iov!).cast[u8](), 1, mem.addr_of(written!)) != 0 or written <= 0 {
            return false
        }
        done += written as usize
    }
    return true
}

pub unsafe fn bool write(i32 fd, Ptr[u8] data, usize len) {
    return write_fd(fd, data, len)
}

static var [u8; 4096] IN_BUF = [0; 4096]
static var usize IN_POS = 0
static var usize IN_LEN = 0

unsafe fn i32 read_byte() {
    if IN_POS == IN_LEN {
        var [usize; 2] iov = [mem.addr_of(IN_BUF!).cast[u8]().addr(), 4096]
        var i32 got = 0
        if fd_read(0, mem.addr_of(iov!).cast[u8](), 1, mem.addr_of(got!)) != 0 or got <= 0 {
            return -1
        }
        IN_POS = 0
        IN_LEN = got as usize
    }
    let b = IN_BUF[IN_POS]
    IN_POS += 1
    return b as i32
}

pub fn bool read_line(String out!) {
    rt.flush()
    var Vec[u8] bytes = Vec.new()
    var any_ = false
    unsafe {
        loop {
            let b = read_byte()
            if b < 0 {
                break
            }
            any_ = true
            if b == 10 {
                break
            }
            bytes.push(b as u8)
        }
    }
    if not any_ {
        return false
    }
    if bytes.len() > 0 and bytes[bytes.len() - 1] == 13 {
        let _ = bytes.pop()
    }
    out = unsafe { String.from_bytes_lossy(bytes.as_ptr(), bytes.len()) }
    return true
}

// ---------------------------------------------------------------------------
// Command line and environment

unsafe fn usize c_len(Ptr[u8] p) {
    var usize n = 0
    while p.offset(n).read() != 0 {
        n += 1
    }
    return n
}

/// The arguments or the environment as strings.
fn Vec[String] strings(bool environment) {
    var Vec[String] out = Vec.new()
    unsafe {
        var i32 count = 0
        var i32 size = 0
        let r = if environment { environ_sizes_get(mem.addr_of(count!), mem.addr_of(size!)) } else { args_sizes_get(mem.addr_of(count!), mem.addr_of(size!)) }
        if r != 0 or count == 0 {
            return out
        }
        let ptrs = mem.alloc((count as usize) * 4).cast[Ptr[u8]]()
        let buf = mem.alloc(size as usize)
        let r2 = if environment { environ_get(ptrs, buf) } else { args_get(ptrs, buf) }
        if r2 == 0 {
            for i in 0..count as usize {
                let p = ptrs.offset(i).read()
                out.push(String.from_bytes_lossy(p, c_len(p)))
            }
        }
        mem.free(buf)
        mem.free(ptrs.cast[u8]())
    }
    return out
}

pub fn i32 arg_count() {
    return strings(false).len() as i32
}

pub fn String arg(i32 index) {
    let all = strings(false)
    if index < 0 or index as usize >= all.len() {
        panic("argument index {index} out of range")
    }
    return all[index as usize].clone()
}

pub fn Option[String] env(String name) {
    let prefix = name + "="
    for e in strings(true) {
        if e.starts_with(prefix) {
            return Some(e.substring(prefix.len(), e.len()))
        }
    }
    return None
}

pub fn bool env_is_set(String name) {
    return env(name).is_some()
}

// ---------------------------------------------------------------------------
// Files

/// A preopened directory for `path`, and the path relative to it.
fn (i32, String) resolve(String path) {
    var i32 best = -1
    var usize best_len = 0
    var rel = path.clone()
    unsafe {
        var i32 fd = 3
        while fd < 64 {
            var [u32; 2] pre = [0; 2]
            if fd_prestat_get(fd, mem.addr_of(pre!).cast[u8]()) != 0 {
                break
            }
            let n = pre[1] as usize
            let name_buf = mem.alloc(n + 1)
            if fd_prestat_dir_name(fd, name_buf, n as i32) == 0 {
                let name = String.from_bytes_lossy(name_buf, n)
                if name == "." or name == "./" {
                    if best < 0 and not path.starts_with("/") {
                        best = fd
                        rel = if path.starts_with("./") { path.substring(2, path.len()) } else { path.clone() }
                    }
                } else if path.starts_with(name) and name.len() > best_len {
                    best = fd
                    best_len = name.len()
                    var r = path.substring(name.len(), path.len())
                    if r.starts_with("/") {
                        r = r.substring(1, r.len())
                    }
                    rel = if r.len() == 0 { "." } else { r }
                }
            }
            mem.free(name_buf)
            fd += 1
        }
    }
    if best < 0 {
        // Without a matching preopen, try the first one.
        return (3, if path.starts_with("/") { path.substring(1, path.len()) } else { path.clone() })
    }
    return (best, rel)
}

/// A file descriptor, or minus the error code (`errno`).
unsafe fn i32 open(String path, i32 oflags, i64 rights, i32 fdflags) {
    let (dir, rel) = resolve(path)
    var i32 fd = -1
    let errno = path_open(dir, 1, rel.as_ptr(), rel.len() as i32, oflags, rights, rights, fdflags, mem.addr_of(fd!))
    if errno != 0 {
        return -errno
    }
    return fd
}

/// Reads a whole file into `out` (bytes). Returns 0, or the error code (`errno`).
pub fn i32 read_file(String path, Vec[u8] out!) {
    unsafe {
        // Rights: fd_read (2) | fd_seek (4) | fd_tell (32) | fd_filestat_get (2097152)
        let fd = open(path, 0, 2097190, 0)
        if fd < 0 {
            return -fd
        }
        var i32 code = 0
        loop {
            out.reserve(65536)
            var [usize; 2] iov = [out.as_ptr().offset(out.len()).addr(), 65536]
            var i32 got = 0
            let errno = fd_read(fd, mem.addr_of(iov!).cast[u8](), 1, mem.addr_of(got!))
            if errno != 0 {
                code = errno
                break
            }
            if got <= 0 {
                break
            }
            out.set_len(out.len() + got as usize)
        }
        let _ = fd_close(fd)
        return code
    }
}

/// Creates (or replaces, or appends to) a file. Returns 0, or the error code (`errno`).
pub fn i32 write_file(String path, Ptr[u8] data, usize len, bool append) {
    unsafe {
        // oflags: creat (1) | trunc (8); fdflags: append (1); rights: fd_write (64)
        let fd = if append { open(path, 1, 64, 1) } else { open(path, 9, 64, 0) }
        if fd < 0 {
            return -fd
        }
        let ok = write_fd(fd, data, len)
        let closed = fd_close(fd)
        if not ok {
            return 29 // EIO: `write_fd` does not keep the code
        }
        return closed
    }
}

/// The `std.io` category of an error code returned by `read_file` or `write_file`
/// (ADR 0015): 1 not found, 2 permission denied, 3 already exists, 4 interrupted,
/// 0 another error.
pub fn u8 io_error_kind(i32 code) {
    return when code {
        44 then 1 // ENOENT
        2 | 63 then 2 // EACCES, EPERM
        20 then 3 // EEXIST
        27 then 4 // EINTR
        _ then 0
    }
}

// ---------------------------------------------------------------------------
// Time

unsafe fn i64 clock(i32 id) {
    var i64 t = 0
    let _ = clock_time_get(id, 1, mem.addr_of(t!))
    return t
}

pub fn u64 monotonic_ns() {
    return unsafe { clock(1) } as u64
}

pub fn i64 unix_time_ns() {
    return unsafe { clock(0) }
}

/// WASI has no time zones: local time is UTC.
pub fn i32 utc_offset(i64 unix_seconds) {
    let _ = unix_seconds
    return 0
}

pub fn sleep_ns(u64 ns) {
    if ns == 0 {
        return
    }
    unsafe {
        // One clock subscription: relative timeout on the monotonic clock.
        var [u64; 6] sub = [0; 6]
        sub[2] = 1
        sub[3] = ns
        var [u64; 4] events = [0; 4]
        var i32 n = 0
        let _ = poll_oneoff(mem.addr_of(sub!).cast[u8](), mem.addr_of(events!).cast[u8](), 1, mem.addr_of(n!))
    }
}

// ---------------------------------------------------------------------------
// Random numbers

pub unsafe fn bool random_bytes(Ptr[u8] buffer, usize len) {
    return random_get(buffer, len as i32) == 0
}

/// The lock of the runtime (ADR 0013, task C5): nothing to lock on a target without
/// threads or interrupts.
pub type CriticalSection is Copy {
    bool unused
}

pub unsafe fn CriticalSection critical_section() {
    return CriticalSection(unused: false)
}

// ---------------------------------------------------------------------------
// Threads (ADR 0013): none on this target. `std.tache` runs each task when it is
// launched, which is one of the orders allowed by its rules.

/// Returns 0: the caller runs `entry(arg)` itself.
pub unsafe fn usize thread_start(owned fn(Ptr[u8]) entry, Ptr[u8] arg) {
    let _ = entry
    let _ = arg
    return 0
}

pub unsafe fn thread_join(usize handle) {
    let _ = handle
}

pub fn u64 thread_id() {
    return 0
}

pub fn thread_yield() {
}

/// Without threads, a task that waits can never be woken: the other tasks have already run
/// or run after it.
pub unsafe fn wait_on(Ptr[u32] p, u32 expected) {
    let _ = p
    let _ = expected
    panic("a task waits for a value that no other task can give: this target runs the tasks one after the other")
}

pub unsafe fn wake_all(Ptr[u32] p) {
    let _ = p
}

pub unsafe fn wake_one(Ptr[u32] p) {
    let _ = p
}
