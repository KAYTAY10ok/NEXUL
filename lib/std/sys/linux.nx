/// System layer for Linux (spec §5.3).
///
/// NEXUL programs call the Linux kernel directly (system calls): no C library is needed,
/// and executables are static. The same code serves x86-64, AArch64 and RISC-V; only the
/// system call numbers differ.

import std.mem
import std.rt
import std.heap

/// A Linux system call with six arguments (unused ones are 0). Returns the result, or
/// `-errno` (between -4095 and -1) on failure.
@intrinsic
unsafe fn syscall6(number: isize, a1: isize, a2: isize, a3: isize, a4: isize, a5: isize, a6: isize) -> isize

@cfg("x86_64")
const SYS_READ: isize = 0
@cfg("x86_64")
const SYS_WRITE: isize = 1
@cfg("x86_64")
const SYS_CLOSE: isize = 3
@cfg("x86_64")
const SYS_MMAP: isize = 9
@cfg("x86_64")
const SYS_MUNMAP: isize = 11
@cfg("x86_64")
const SYS_IOCTL: isize = 16
@cfg("x86_64")
const SYS_NANOSLEEP: isize = 35
@cfg("x86_64")
const SYS_EXIT_GROUP: isize = 231
@cfg("x86_64")
const SYS_CLOCK_GETTIME: isize = 228
@cfg("x86_64")
const SYS_OPENAT: isize = 257
@cfg("x86_64")
const SYS_GETRANDOM: isize = 318
@cfg("x86_64")
const SYS_RT_SIGACTION: isize = 13
@cfg("x86_64")
const SYS_SIGALTSTACK: isize = 131
@cfg("x86_64")
const SYS_PRLIMIT64: isize = 302
@cfg("x86_64")
const SYS_GETPID: isize = 39
@cfg("x86_64")
const SYS_KILL: isize = 62

@cfg("!x86_64")
const SYS_READ: isize = 63
@cfg("!x86_64")
const SYS_WRITE: isize = 64
@cfg("!x86_64")
const SYS_CLOSE: isize = 57
@cfg("!x86_64")
const SYS_MMAP: isize = 222
@cfg("!x86_64")
const SYS_MUNMAP: isize = 215
@cfg("!x86_64")
const SYS_IOCTL: isize = 29
@cfg("!x86_64")
const SYS_NANOSLEEP: isize = 101
@cfg("!x86_64")
const SYS_EXIT_GROUP: isize = 94
@cfg("!x86_64")
const SYS_CLOCK_GETTIME: isize = 113
@cfg("!x86_64")
const SYS_OPENAT: isize = 56
@cfg("!x86_64")
const SYS_GETRANDOM: isize = 278
@cfg("!x86_64")
const SYS_RT_SIGACTION: isize = 134
@cfg("!x86_64")
const SYS_SIGALTSTACK: isize = 132
@cfg("!x86_64")
const SYS_PRLIMIT64: isize = 261
@cfg("!x86_64")
const SYS_GETPID: isize = 172
@cfg("!x86_64")
const SYS_KILL: isize = 129

const EINTR: isize = -4
const AT_FDCWD: isize = -100

unsafe fn sys1(n: isize, a: isize) -> isize {
    return syscall6(n, a, 0, 0, 0, 0, 0)
}

unsafe fn sys2(n: isize, a: isize, b: isize) -> isize {
    return syscall6(n, a, b, 0, 0, 0, 0)
}

unsafe fn sys3(n: isize, a: isize, b: isize, c: isize) -> isize {
    return syscall6(n, a, b, c, 0, 0, 0)
}

fn addr(p: Ptr[u8]) -> isize {
    return p.addr() as isize
}

// ---------------------------------------------------------------------------
// Process

/// The initial stack of the process: argc, argv[], NULL, envp[], NULL.
static var ARGC: usize = 0
static var ARGV: Ptr[Ptr[u8]] = Ptr.null()
static var ENVP: Ptr[Ptr[u8]] = Ptr.null()
static var STDOUT_TERMINAL: bool = false

/// Called by the program entry point with the initial stack pointer.
@lang("sys_set_stack")
fn set_stack(sp: Ptr[usize]) {
    unsafe {
        STACK_TOP = sp.addr()
        ARGC = sp.read()
        ARGV = sp.offset(1).cast[Ptr[u8]]()
        ENVP = ARGV.offset(ARGC + 1)
    }
}

// ---------------------------------------------------------------------------
// Stack overflow (ADR 0011, task T2)
//
// The main stack grows down to `STACK_TOP - RLIMIT_STACK`; below lies the guard gap of
// the kernel, which faults. A handler for SIGSEGV and SIGBUS, run on an alternate stack,
// tells a stack overflow (fault address just below the stack) from any other fault: the
// first ends like a panic (`panic: stack overflow`, code 101, standard output flushed),
// the second is raised again with the default action of the system.

/// The highest address of the stack (the initial stack pointer) and its lowest allowed
/// address (from `RLIMIT_STACK`); 0 when unknown.
static var STACK_TOP: usize = 0
static var STACK_LOW: usize = 0
/// The stack of the signal handler.
static var ALT_STACK: [u8; 65536] = [0; 65536]

const SIGBUS: isize = 7
const SIGSEGV: isize = 11
const SA_SIGINFO: usize = 0x4
const SA_RESTORER: usize = 0x0400_0000
const SA_ONSTACK: usize = 0x0800_0000
const SA_NODEFER: usize = 0x4000_0000
const SA_RESETHAND: usize = 0x8000_0000
/// Faults this far below the lowest address of the stack still count as an overflow: the
/// guard gap of the kernel (1 MiB by default) and a large frame.
const GUARD_SPAN: usize = 4_194_304

/// Installs the handler of memory faults. `handler` is the C entry generated by the
/// compiler (`nx_linux_fault`), which calls `fault`.
@lang("sys_set_fault_handler")
fn set_fault_handler(handler: Ptr[u8]) {
    install_fault_handler(handler)
}

fn install_fault_handler(handler: Ptr[u8]) {
    unsafe {
        // RLIMIT_STACK (3): the size of the main stack.
        var limit: [u64; 2] = [0, 0]
        let r = syscall6(SYS_PRLIMIT64, 0, 3, 0, addr(mem.addr_of(&limit).cast[u8]()), 0, 0)
        if r == 0 and limit[0] < 0x0000_1000_0000_0000 and (limit[0] as usize) < STACK_TOP {
            STACK_LOW = STACK_TOP - (limit[0] as usize)
        }
        // stack_t: ss_sp, ss_flags (int, padded), ss_size.
        var alt: [usize; 3] = [mem.addr_of(&ALT_STACK).cast[u8]().addr(), 0, 65536]
        let _ = sys2(SYS_SIGALTSTACK, addr(mem.addr_of(&alt).cast[u8]()), 0)
        // struct sigaction of the kernel (x86-64, AArch64): handler, flags, restorer,
        // mask. The handler never returns, so the restorer is never used; x86-64 still
        // requires one.
        let flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER | SA_RESETHAND
        var action = fault_action(handler, flags)
        let a = addr(mem.addr_of(&action).cast[u8]())
        let _ = syscall6(SYS_RT_SIGACTION, SIGSEGV, a, 0, 8, 0, 0)
        let _ = syscall6(SYS_RT_SIGACTION, SIGBUS, a, 0, 8, 0, 0)
    }
}

// RISC-V uses asm-generic/signal.h without SA_RESTORER: the mask is the
// third word, not the fourth. Keep an unused trailing word for a common size.
@cfg("riscv64")
fn fault_action(handler: Ptr[u8], flags: usize) -> [usize; 4] {
    return [handler.addr(), flags, 0, 0]
}

@cfg("!riscv64")
fn fault_action(handler: Ptr[u8], flags: usize) -> [usize; 4] {
    return [handler.addr(), flags | SA_RESTORER, handler.addr(), 0]
}

/// Called by `nx_linux_fault` on the alternate stack, with the signal and its `siginfo_t`.
@lang("sys_fault")
fn fault(signal: i32, info: Ptr[u8]) -> Never {
    unsafe {
        // si_addr is at offset 16 of siginfo_t on 64-bit Linux.
        let at = info.offset(16).cast[usize]().read()
        let low = if STACK_LOW > GUARD_SPAN { STACK_LOW - GUARD_SPAN } else { 0 }
        if STACK_LOW != 0 and at >= low and at < STACK_TOP {
            rt.flush()
            let msg = "panic: stack overflow (the recursion is probably too deep)\n"
            let _ = write_fd(2, msg.as_ptr(), msg.len())
            exit(101)
        }
        // Any other fault (only possible through `unsafe` code or a foreign function):
        // the handler was reset by SA_RESETHAND, so the signal ends the process as usual.
        let _ = sys2(SYS_KILL, sys1(SYS_GETPID, 0), signal as isize)
        exit(128 + signal)
    }
}

pub fn init() {
    unsafe {
        // TCGETS succeeds on a terminal only.
        var termios: [u8; 64] = [0; 64]
        STDOUT_TERMINAL = sys3(SYS_IOCTL, 1, 0x5401, addr(mem.addr_of(&termios).cast[u8]())) == 0
    }
}

pub fn stdout_is_terminal() -> bool {
    return unsafe { STDOUT_TERMINAL }
}

pub fn exit(code: i32) -> Never {
    unsafe {
        while true {
            let _ = sys1(SYS_EXIT_GROUP, code as isize)
        }
    }
}

// ---------------------------------------------------------------------------
// Memory

const PROT_READ_WRITE: isize = 3
const MAP_PRIVATE_ANONYMOUS: isize = 0x22

/// Pages of zeroed memory from the kernel; null on failure.
pub unsafe fn page_alloc(size: usize) -> Ptr[u8] {
    let r = syscall6(SYS_MMAP, 0, size as isize, PROT_READ_WRITE, MAP_PRIVATE_ANONYMOUS, -1, 0)
    if r < 0 and r > -4096 {
        return Ptr.null()
    }
    return Ptr[u8].from_addr(r as usize)
}

pub unsafe fn page_free(p: Ptr[u8], size: usize) {
    let _ = sys2(SYS_MUNMAP, addr(p), size as isize)
}

pub unsafe fn heap_alloc(size: usize) -> Ptr[u8] {
    return heap.alloc(size)
}

pub unsafe fn heap_realloc(p: Ptr[u8], size: usize) -> Ptr[u8] {
    return heap.realloc(p, size)
}

pub unsafe fn heap_free(p: Ptr[u8]) {
    heap.free(p)
}

// ---------------------------------------------------------------------------
// Input and output

unsafe fn write_fd(fd: isize, data: Ptr[u8], len: usize) -> bool {
    var done: usize = 0
    while done < len {
        let r = sys3(SYS_WRITE, fd, addr(data.offset(done)), (len - done) as isize)
        if r == EINTR {
            continue
        }
        if r <= 0 {
            return false
        }
        done += r as usize
    }
    return true
}

/// Writes bytes to standard output (`fd` 1) or standard error (`fd` 2).
pub unsafe fn write(fd: i32, data: Ptr[u8], len: usize) -> bool {
    return write_fd(fd as isize, data, len)
}

static var IN_BUF: [u8; 4096] = [0; 4096]
static var IN_POS: usize = 0
static var IN_LEN: usize = 0

unsafe fn read_byte() -> i32 {
    if IN_POS == IN_LEN {
        while true {
            let r = sys3(SYS_READ, 0, addr(mem.addr_of(&IN_BUF).cast[u8]()), 4096)
            if r == EINTR {
                continue
            }
            if r <= 0 {
                return -1
            }
            IN_POS = 0
            IN_LEN = r as usize
            break
        }
    }
    let b = IN_BUF[IN_POS]
    IN_POS += 1
    return b as i32
}

/// Reads one line of standard input without its terminator; `false` at the end.
pub fn read_line(inout out: String) -> bool {
    rt.flush()
    var bytes: Vec[u8] = Vec.new()
    var any = false
    unsafe {
        while true {
            let b = read_byte()
            if b < 0 {
                break
            }
            any = true
            if b == 10 {
                break
            }
            bytes.push(b as u8)
        }
    }
    if not any {
        return false
    }
    if bytes.len() > 0 and bytes[bytes.len() - 1] == 13 {
        let _ = bytes.pop()
    }
    out = unsafe { String.from_bytes_lossy(bytes.as_ptr(), bytes.len()) }
    return true
}

// ---------------------------------------------------------------------------
// Command line and environment

unsafe fn c_len(p: Ptr[u8]) -> usize {
    var n: usize = 0
    while p.offset(n).read() != 0 {
        n += 1
    }
    return n
}

pub fn arg_count() -> i32 {
    return unsafe { ARGC } as i32
}

pub fn arg(index: i32) -> String {
    unsafe {
        if index < 0 or index as usize >= ARGC {
            panic("argument index {index} out of range")
        }
        let p = ARGV.offset(index as usize).read()
        return String.from_bytes_lossy(p, c_len(p))
    }
}

pub fn env(name: String) -> Option[String] {
    unsafe {
        if ENVP.is_null() {
            return None
        }
        var i: usize = 0
        while true {
            let e = ENVP.offset(i).read()
            if e.is_null() {
                break
            }
            let n = c_len(e)
            if n > name.len() and e.offset(name.len()).read() == '=' as u8 {
                var same = true
                for k in 0..name.len() {
                    if e.offset(k).read() != name.byte_at(k) {
                        same = false
                        break
                    }
                }
                if same {
                    let start = name.len() + 1
                    return Some(String.from_bytes_lossy(e.offset(start), n - start))
                }
            }
            i += 1
        }
        return None
    }
}

pub fn env_is_set(name: String) -> bool {
    return env(name).is_some()
}

// ---------------------------------------------------------------------------
// Files

/// `path` followed by a zero byte, for the kernel.
fn c_path(path: String) -> Vec[u8] {
    var v = path.clone().into_bytes()
    v.push(0)
    return v
}

unsafe fn open(path: String, flags: isize) -> isize {
    let p = c_path(path)
    while true {
        let fd = syscall6(SYS_OPENAT, AT_FDCWD, addr(p.as_ptr()), flags, 420, 0, 0)
        if fd != EINTR {
            return fd
        }
    }
}

/// Reads a whole file into `out` (bytes).
pub fn read_file(path: String, inout out: Vec[u8]) -> bool {
    unsafe {
        let fd = open(path, 0x80000)
        if fd < 0 {
            return false
        }
        var ok = true
        while true {
            out.reserve(65536)
            let r = sys3(SYS_READ, fd, addr(out.as_ptr().offset(out.len())), 65536)
            if r == EINTR {
                continue
            }
            if r < 0 {
                ok = false
                break
            }
            if r == 0 {
                break
            }
            out.set_len(out.len() + r as usize)
        }
        let _ = sys1(SYS_CLOSE, fd)
        return ok
    }
}

/// Creates (or replaces, or appends to) a file.
pub fn write_file(path: String, data: Ptr[u8], len: usize, append: bool) -> bool {
    unsafe {
        // O_WRONLY | O_CREAT | O_CLOEXEC, then O_APPEND or O_TRUNC.
        let flags: isize = if append { 0x80441 } else { 0x80241 }
        let fd = open(path, flags)
        if fd < 0 {
            return false
        }
        let ok = write_fd(fd, data, len)
        let closed = sys1(SYS_CLOSE, fd) == 0
        return ok and closed
    }
}

// ---------------------------------------------------------------------------
// Time

unsafe fn clock(id: isize) -> (i64, i64) {
    var ts: [i64; 2] = [0; 2]
    let _ = sys2(SYS_CLOCK_GETTIME, id, addr(mem.addr_of(&ts).cast[u8]()))
    return (ts[0], ts[1])
}

pub fn monotonic_ns() -> u64 {
    let (s, ns) = unsafe { clock(1) }
    return (s as u64) * 1_000_000_000 + (ns as u64)
}

pub fn unix_time_ns() -> i64 {
    let (s, ns) = unsafe { clock(0) }
    return s * 1_000_000_000 + ns
}

pub fn sleep_ns(ns: u64) {
    var req: [i64; 2] = [(ns / 1_000_000_000) as i64, (ns % 1_000_000_000) as i64]
    var rem: [i64; 2] = [0; 2]
    unsafe {
        while true {
            let r = sys2(SYS_NANOSLEEP, addr(mem.addr_of(&req).cast[u8]()), addr(mem.addr_of(&rem).cast[u8]()))
            if r != EINTR {
                break
            }
            req = rem
        }
    }
}

/// Reads a big-endian signed 32 or 64-bit number.
fn be(data: Vec[u8], at: usize, size: usize) -> i64 {
    var v: u64 = 0
    for i in 0..size {
        v = (v << 8) | (data[at + i] as u64)
    }
    if size == 4 {
        if v >= 0x8000_0000 {
            return (v as i64) - 0x1_0000_0000
        }
        return v as i64
    }
    if v >= 0x8000_0000_0000_0000 {
        return 0 - ((0xFFFF_FFFF_FFFF_FFFF - v) as i64) - 1
    }
    return v as i64
}

/// Offset of local time from UTC at `unix_seconds`, from the time zone database
/// (`TZ`, else `/etc/localtime`, in TZif format); 0 without time zone information.
pub fn utc_offset(unix_seconds: i64) -> i32 {
    var path = "/etc/localtime"
    match env("TZ") {
        Some(tz) => {
            if tz.len() == 0 or tz == "UTC" or tz == "UTC0" or tz == ":UTC" {
                return 0
            }
            let name = if tz.starts_with(":") { tz.substring(1, tz.len()) } else { tz.clone() }
            if name.starts_with("/") {
                path = name
            } else if not name.contains(",") {
                path = "/usr/share/zoneinfo/" + name
            } else {
                return posix_offset(name, unix_seconds)
            }
        }
        None => {}
    }
    var data: Vec[u8] = Vec.new()
    if not read_file(path, &data) or data.len() < 44 or data[0] != 'T' as u8 or data[1] != 'Z' as u8 {
        return 0
    }
    // Version 2+ files repeat the data with 64-bit times after the first block.
    var base: usize = 0
    var time_size: usize = 4
    let version = data[4]
    if version >= '2' as u8 {
        let block = tzif_block_len(data, 0, 4)
        if 44 + block + 44 <= data.len() {
            base = 44 + block
            time_size = 8
        }
    }
    let isutcnt = be(data, base + 20, 4) as usize
    let isstdcnt = be(data, base + 24, 4) as usize
    let leapcnt = be(data, base + 28, 4) as usize
    let timecnt = be(data, base + 32, 4) as usize
    let typecnt = be(data, base + 36, 4) as usize
    let charcnt = be(data, base + 40, 4) as usize
    let times = base + 44
    let idx = times + timecnt * time_size
    let types = idx + timecnt
    if types + typecnt * 6 > data.len() or typecnt == 0 {
        return 0
    }
    // The last transition at or before the instant.
    var current: i64 = -1
    for i in 0..timecnt {
        if be(data, times + i * time_size, time_size) <= unix_seconds {
            current = i as i64
        } else {
            break
        }
    }
    if current < 0 {
        // Before the first transition: the first standard-time type.
        return be(data, types, 4) as i32
    }
    if current as usize == timecnt - 1 and time_size == 8 {
        // After the last transition: the POSIX rule of the footer, when there is one.
        let footer = types + typecnt * 6 + charcnt + leapcnt * (time_size + 4) + isstdcnt + isutcnt
        if footer + 1 < data.len() and data[footer] == 10 {
            var rule = String.new()
            var k = footer + 1
            while k < data.len() and data[k] != 10 {
                rule.push(data[k] as char)
                k += 1
            }
            if rule.len() > 0 {
                return posix_offset(rule, unix_seconds)
            }
        }
    }
    let t = data[idx + current as usize] as usize
    return be(data, types + t * 6, 4) as i32
}

fn tzif_block_len(data: Vec[u8], base: usize, time_size: usize) -> usize {
    let isutcnt = be(data, base + 20, 4) as usize
    let isstdcnt = be(data, base + 24, 4) as usize
    let leapcnt = be(data, base + 28, 4) as usize
    let timecnt = be(data, base + 32, 4) as usize
    let typecnt = be(data, base + 36, 4) as usize
    let charcnt = be(data, base + 40, 4) as usize
    return timecnt * time_size + timecnt + typecnt * 6 + charcnt + leapcnt * (time_size + 4) + isstdcnt + isutcnt
}

/// Days from 1970-01-01 to a civil date (proleptic Gregorian calendar).
fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = (if y >= 0 { y } else { y - 399 }) / 400
    let yoe = y - era * 400
    let doy = (153 * (if month > 2 { month - 3 } else { month + 9 }) + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146_097 + doe - 719_468
}

fn year_of(days: i64) -> i64 {
    let z = days + 719_468
    let era = (if z >= 0 { z } else { z - 146_096 }) / 146_097
    let doe = z - era * 146_097
    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    return yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
}

/// A small cursor over a POSIX TZ rule such as `CET-1CEST,M3.5.0,M10.5.0/3`.
struct Cursor {
    text: Vec[u8]
    pos: usize
}

impl Cursor {
    fn peek(self) -> u8 {
        if self.pos < self.text.len() {
            return self.text[self.pos]
        }
        return 0
    }

    fn skip_name(inout self) {
        if self.peek() == '<' as u8 {
            while self.pos < self.text.len() and self.text[self.pos] != '>' as u8 {
                self.pos += 1
            }
            self.pos += 1
            return
        }
        while self.pos < self.text.len() {
            let c = self.text[self.pos]
            if (c >= 'A' as u8 and c <= 'Z' as u8) or (c >= 'a' as u8 and c <= 'z' as u8) {
                self.pos += 1
            } else {
                break
            }
        }
    }

    fn number(inout self) -> i64 {
        var v: i64 = 0
        while self.pos < self.text.len() and self.text[self.pos] >= '0' as u8 and self.text[self.pos] <= '9' as u8 {
            v = v * 10 + (self.text[self.pos] - '0' as u8) as i64
            self.pos += 1
        }
        return v
    }

    /// `[+-]hh[:mm[:ss]]` in seconds.
    fn time(inout self) -> i64 {
        var sign: i64 = 1
        if self.peek() == '-' as u8 {
            sign = -1
            self.pos += 1
        } else if self.peek() == '+' as u8 {
            self.pos += 1
        }
        var t = self.number() * 3600
        if self.peek() == ':' as u8 {
            self.pos += 1
            t += self.number() * 60
            if self.peek() == ':' as u8 {
                self.pos += 1
                t += self.number()
            }
        }
        return sign * t
    }
}

/// The instant (seconds since 1970, local wall clock) a rule `Mm.w.d[/time]`, `Jn` or `n`
/// designates in `year`.
fn rule_time(inout c: Cursor, year: i64) -> i64 {
    var day: i64 = 0
    if c.peek() == 'M' as u8 {
        c.pos += 1
        let month = c.number()
        c.pos += 1
        let week = c.number()
        c.pos += 1
        let weekday = c.number()
        let first = days_from_civil(year, month, 1)
        // 1970-01-01 was a Thursday (4).
        let first_wd = ((first % 7) + 7 + 4) % 7
        day = first + ((weekday - first_wd) % 7 + 7) % 7 + (week - 1) * 7
        let next_month = if month == 12 { days_from_civil(year + 1, 1, 1) } else { days_from_civil(year, month + 1, 1) }
        while day >= next_month {
            day -= 7
        }
    } else if c.peek() == 'J' as u8 {
        c.pos += 1
        let n = c.number()
        let leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
        day = days_from_civil(year, 1, 1) + n - 1 + (if leap and n >= 60 { 1 } else { 0 })
    } else {
        day = days_from_civil(year, 1, 1) + c.number()
    }
    var at: i64 = 7200
    if c.peek() == '/' as u8 {
        c.pos += 1
        at = c.time()
    }
    return day * 86_400 + at
}

/// Offset given by a POSIX TZ rule (the footer of TZif files, or `TZ`).
fn posix_offset(rule: String, unix_seconds: i64) -> i32 {
    var c = Cursor(text: rule.clone().into_bytes(), pos: 0)
    c.skip_name()
    // POSIX offsets are positive west of Greenwich.
    let std_offset = 0 - c.time()
    if c.pos >= c.text.len() {
        return std_offset as i32
    }
    c.skip_name()
    var dst_offset = std_offset + 3600
    if c.peek() != ',' as u8 and c.pos < c.text.len() {
        dst_offset = 0 - c.time()
    }
    if c.peek() != ',' as u8 {
        return std_offset as i32
    }
    c.pos += 1
    let year = year_of((unix_seconds + std_offset) / 86_400)
    let start_cursor_pos = c.pos
    let start_local = rule_time(&c, year)
    c.pos += 1
    let end_local = rule_time(&c, year)
    let _ = start_cursor_pos
    // Transitions in UTC: the start is given in standard time, the end in daylight time.
    let start = start_local - std_offset
    let end = end_local - dst_offset
    let in_dst = if start < end { unix_seconds >= start and unix_seconds < end } else { unix_seconds >= start or unix_seconds < end }
    return (if in_dst { dst_offset } else { std_offset }) as i32
}

// ---------------------------------------------------------------------------
// Random numbers

/// Fills `buffer` with cryptographically secure random bytes (`getrandom`).
pub unsafe fn random_bytes(buffer: Ptr[u8], len: usize) -> bool {
    var done: usize = 0
    while done < len {
        let r = sys3(SYS_GETRANDOM, addr(buffer.offset(done)), (len - done) as isize, 0)
        if r == EINTR {
            continue
        }
        if r <= 0 {
            return false
        }
        done += r as usize
    }
    return true
}
