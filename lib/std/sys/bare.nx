/// System layer for bare metal: microcontrollers and boards without an operating system
/// (spec §7).
///
/// - The startup code (generated by the compiler) sets up the stack, copies `.data`,
///   clears `.bss`, enables the floating-point unit, and calls the program.
/// - The console, the clock, the command line and the files of the host go through
///   *semihosting*: a debug probe (or QEMU) executes the requests of the program. On a
///   board without a debugger, programs write to their peripherals directly
///   (`Ptr.from_addr`, `mem.write_volatile`).
/// - The heap lies between the end of the data and the stack; there is no random
///   generator (`random.secure_*` panic).

import std.mem
import std.rt
import std.heap

/// A semihosting request: operation number and parameter (usually a parameter block).
@intrinsic
unsafe fn semihost(op: usize, param: usize) -> isize

/// The start of the free RAM, after the data (`__heap_start` of the linker script).
@intrinsic
unsafe fn heap_start() -> Ptr[u8]

/// The top of the stack, at the end of the RAM (`__stack_top`).
@intrinsic
unsafe fn stack_top() -> Ptr[u8]

/// Save the interrupt mask, then mask interrupts. The memory clobber on the
/// intrinsic prevents accesses to runtime state from crossing the boundary.
@intrinsic
unsafe fn irq_save() -> usize
@intrinsic
unsafe fn irq_restore(state: usize)

/// A nested critical section on a single core. Only maskable interrupts are
/// covered: NMI/fault handlers must not allocate or print (review required).
pub struct CriticalSection {
    state: usize
}

impl CriticalSection {
    fn drop(inout self) {
        unsafe { irq_restore(self.state) }
    }
}

/// Internal runtime guard. Restore the saved mask, never unconditionally enable
/// interrupts: allocator calls can nest and can run inside an interrupt handler.
pub unsafe fn critical_section() -> CriticalSection {
    return CriticalSection(state: irq_save())
}

const SYS_OPEN: usize = 0x01
const SYS_CLOSE: usize = 0x02
const SYS_WRITE: usize = 0x05
const SYS_READ: usize = 0x06
const SYS_READC: usize = 0x07
const SYS_FLEN: usize = 0x0C
const SYS_TIME: usize = 0x11
const SYS_GET_CMDLINE: usize = 0x15
const SYS_EXIT_EXTENDED: usize = 0x20
const SYS_ELAPSED: usize = 0x30
const SYS_TICKFREQ: usize = 0x31

/// Space kept for the stack below the top of RAM.
const STACK_RESERVE: usize = 65536

static var STDOUT: isize = -1
static var STDERR: isize = -1
static var HEAP_NEXT: Ptr[u8] = Ptr.null()
static var HEAP_END: Ptr[u8] = Ptr.null()
static var FREE_REGIONS: Ptr[u8] = Ptr.null()

fn addr(p: Ptr[u8]) -> usize {
    return p.addr()
}

unsafe fn open_host(name: String, mode: usize) -> isize {
    var block: [usize; 3] = [addr(name.as_ptr()), mode, name.len()]
    return semihost(SYS_OPEN, addr(mem.addr_of(&block).cast[u8]()))
}

/// Called by the startup code before the program.
@lang("sys_reset")
fn reset() {
    unsafe {
        HEAP_NEXT = heap_start()
        HEAP_END = stack_top().sub(STACK_RESERVE)
    }
}

pub fn init() {
    unsafe {
        // ":tt" is the console: mode 4 ("w") for the output, 8 ("a") for the errors.
        STDOUT = open_host(":tt", 4)
        STDERR = open_host(":tt", 8)
    }
}

pub fn stdout_is_terminal() -> bool {
    return true
}

pub fn exit(code: i32) -> Never {
    unsafe {
        // ADP_Stopped_ApplicationExit with the exit code.
        var block: [usize; 2] = [0x20026, if code < 0 { 1 } else { code as usize }]
        while true {
            let _ = semihost(SYS_EXIT_EXTENDED, addr(mem.addr_of(&block).cast[u8]()))
        }
    }
}

// ---------------------------------------------------------------------------
// Memory

pub unsafe fn page_alloc(size: usize) -> Ptr[u8] {
    var prev: Ptr[u8] = Ptr.null()
    var r = FREE_REGIONS
    while not r.is_null() {
        let rsize = r.cast[usize]().read()
        let next = r.offset(mem.size_of[usize]()).cast[Ptr[u8]]().read()
        if rsize >= size {
            if prev.is_null() {
                FREE_REGIONS = next
            } else {
                prev.offset(mem.size_of[usize]()).cast[Ptr[u8]]().write(next)
            }
            mem.set_bytes(r, 0, size)
            return r
        }
        prev = r
        r = next
    }
    // 16-byte aligned bump allocation in the free RAM.
    let start = (HEAP_NEXT.addr() + 15) / 16 * 16
    if start + size > HEAP_END.addr() or start + size < start {
        return Ptr.null()
    }
    HEAP_NEXT = Ptr[u8].from_addr(start + size)
    let p = Ptr[u8].from_addr(start)
    mem.set_bytes(p, 0, size)
    return p
}

pub unsafe fn page_free(p: Ptr[u8], size: usize) {
    p.cast[usize]().write(size)
    p.offset(mem.size_of[usize]()).cast[Ptr[u8]]().write(FREE_REGIONS)
    FREE_REGIONS = p
}

pub unsafe fn heap_alloc(size: usize) -> Ptr[u8] {
    return heap.alloc(size)
}

pub unsafe fn heap_realloc(p: Ptr[u8], size: usize) -> Ptr[u8] {
    return heap.realloc(p, size)
}

pub unsafe fn heap_free(p: Ptr[u8]) {
    heap.free(p)
}

// ---------------------------------------------------------------------------
// Console

unsafe fn write_handle(h: isize, data: Ptr[u8], len: usize) -> bool {
    if h < 0 {
        return false
    }
    var block: [usize; 3] = [h as usize, addr(data), len]
    // Returns the number of bytes NOT written.
    return semihost(SYS_WRITE, addr(mem.addr_of(&block).cast[u8]())) == 0
}

pub unsafe fn write(fd: i32, data: Ptr[u8], len: usize) -> bool {
    return write_handle(if fd == 2 { STDERR } else { STDOUT }, data, len)
}

pub fn read_line(inout out: String) -> bool {
    rt.flush()
    var bytes: Vec[u8] = Vec.new()
    var any = false
    unsafe {
        while true {
            let c = semihost(SYS_READC, 0)
            if c < 0 or c == 4 {
                break
            }
            any = true
            if c == 10 {
                break
            }
            bytes.push((c & 0xFF) as u8)
        }
    }
    if not any {
        return false
    }
    if bytes.len() > 0 and bytes[bytes.len() - 1] == 13 {
        let _ = bytes.pop()
    }
    out = unsafe { String.from_bytes_lossy(bytes.as_ptr(), bytes.len()) }
    return true
}

// ---------------------------------------------------------------------------
// Command line and environment

fn command_line() -> Vec[String] {
    var out: Vec[String] = Vec.new()
    unsafe {
        let buf = mem.alloc(1024)
        var block: [usize; 2] = [addr(buf), 1024]
        if semihost(SYS_GET_CMDLINE, addr(mem.addr_of(&block).cast[u8]())) == 0 {
            let text = String.from_bytes_lossy(buf, block[1])
            for part in text.split(" ") {
                if part.len() > 0 {
                    out.push(part.clone())
                }
            }
        }
        mem.free(buf)
    }
    if out.len() == 0 {
        out.push("program")
    }
    return out
}

pub fn arg_count() -> i32 {
    return command_line().len() as i32
}

pub fn arg(index: i32) -> String {
    let all = command_line()
    if index < 0 or index as usize >= all.len() {
        panic("argument index {index} out of range")
    }
    return all[index as usize].clone()
}

/// There is no environment without an operating system.
pub fn env(name: String) -> Option[String] {
    let _ = name
    return None
}

pub fn env_is_set(name: String) -> bool {
    let _ = name
    return false
}

// ---------------------------------------------------------------------------
// Files of the host

/// Reads a whole file of the host into `out` (bytes). Returns 0, or -1: semihosting
/// gives no portable error code.
pub fn read_file(path: String, inout out: Vec[u8]) -> i32 {
    unsafe {
        // Mode 1: "rb".
        let h = open_host(path, 1)
        if h < 0 {
            return -1
        }
        var fb: [usize; 1] = [h as usize]
        let len = semihost(SYS_FLEN, addr(mem.addr_of(&fb).cast[u8]()))
        var ok = len >= 0
        if ok {
            let n = len as usize
            out.reserve(n)
            var block: [usize; 3] = [h as usize, addr(out.as_ptr().offset(out.len())), n]
            let missing = semihost(SYS_READ, addr(mem.addr_of(&block).cast[u8]()))
            if missing < 0 or missing as usize > n {
                ok = false
            } else {
                out.set_len(out.len() + n - missing as usize)
            }
        }
        let _ = semihost(SYS_CLOSE, addr(mem.addr_of(&fb).cast[u8]()))
        return if ok { 0 } else { -1 }
    }
}

/// Creates (or replaces, or appends to) a file of the host. Returns 0, or -1.
pub fn write_file(path: String, data: Ptr[u8], len: usize, append: bool) -> i32 {
    unsafe {
        // Mode 5: "wb", 9: "ab".
        let h = open_host(path, if append { 9 } else { 5 })
        if h < 0 {
            return -1
        }
        let ok = len == 0 or write_handle(h, data, len)
        var fb: [usize; 1] = [h as usize]
        let _ = semihost(SYS_CLOSE, addr(mem.addr_of(&fb).cast[u8]()))
        return if ok { 0 } else { -1 }
    }
}

/// The `std.io` category of an error code returned by `read_file` or `write_file`
/// (ADR 0015): 1 not found, 2 permission denied, 3 already exists, 4 interrupted,
/// 0 another error.
pub fn io_error_kind(code: i32) -> u8 {
    let _ = code
    return 0
}

// ---------------------------------------------------------------------------
// Time

pub fn monotonic_ns() -> u64 {
    unsafe {
        var ticks: [u32; 2] = [0; 2]
        if semihost(SYS_ELAPSED, addr(mem.addr_of(&ticks).cast[u8]())) != 0 {
            return 0
        }
        let freq = semihost(SYS_TICKFREQ, 0)
        let t = ((ticks[1] as u64) << 32) | (ticks[0] as u64)
        if freq <= 0 {
            return t
        }
        let f = freq as u64
        return (t / f) * 1_000_000_000 + (t % f) * 1_000_000_000 / f
    }
}

pub fn unix_time_ns() -> i64 {
    return unsafe { semihost(SYS_TIME, 0) } as i64 * 1_000_000_000
}

pub fn utc_offset(unix_seconds: i64) -> i32 {
    let _ = unix_seconds
    return 0
}

/// Busy waiting on the clock (no scheduler without an operating system).
pub fn sleep_ns(ns: u64) {
    let start = monotonic_ns()
    while monotonic_ns() - start < ns {
    }
}

// ---------------------------------------------------------------------------
// Random numbers

/// No entropy source is known without an operating system.
pub unsafe fn random_bytes(buffer: Ptr[u8], len: usize) -> bool {
    let _ = buffer
    let _ = len
    return false
}

// ---------------------------------------------------------------------------
// Threads (ADR 0013): none on this target. `std.tache` runs each task when it is
// launched, which is one of the orders allowed by its rules.

/// Returns 0: the caller runs `entry(arg)` itself.
pub unsafe fn thread_start(owned entry: fn(Ptr[u8]), arg: Ptr[u8]) -> usize {
    let _ = entry
    let _ = arg
    return 0
}

pub unsafe fn thread_join(handle: usize) {
    let _ = handle
}

pub fn thread_id() -> u64 {
    return 0
}

pub fn thread_yield() {
}

/// Without threads, a task that waits can never be woken: the other tasks have already run
/// or run after it.
pub unsafe fn wait_on(p: Ptr[u32], expected: u32) {
    let _ = p
    let _ = expected
    panic("a task waits for a value that no other task can give: this target runs the tasks one after the other")
}

pub unsafe fn wake_all(p: Ptr[u32]) {
    let _ = p
}
