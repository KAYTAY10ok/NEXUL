// edition: 1
/// Core types of NEXUL: `Option` and `Result` (spec chapter 07).

import std.mem

/// An optional value: either `Some(value)` or `None`.
@lang("option")
@derive(Copy)
pub type Option[T] = .Some(T) | .None

extend Option {
    /// `true` if the option contains a value.
    pub fn bool is_some(self) {
        when self {
            .Some(_) then return true
            .None then return false
        }
    }

    /// `true` if the option is `None`.
    pub fn bool is_none(self) {
        return not self.is_some()
    }

    /// The contained value; panics if the option is `None`.
    @track_caller
    pub fn T unwrap(owned self) {
        when move self {
            .Some(value) then return value
            .None then panic("called `Option.unwrap()` on a `None` value")
        }
    }

    /// The contained value; panics with `message` if the option is `None`.
    @track_caller
    pub fn T expect(owned self, String message) {
        when move self {
            .Some(value) then return value
            .None then panic(message)
        }
    }

    /// The contained value, or `default` if the option is `None`.
    pub fn T unwrap_or(owned self, owned T default) {
        when move self {
            .Some(value) then return value
            .None then return default
        }
    }

    /// Takes the value out of the option, leaving `None` in its place.
    pub fn Option[T] take(self!) {
        return mem.replace(self!, None)
    }
}

/// The result of an operation that can fail: `Ok(value)` or `Err(error)`.
@lang("result")
@derive(Copy)
pub type Result[T, E] = .Ok(T) | .Err(E)

extend Result {
    /// `true` if the result is `Ok`.
    pub fn bool is_ok(self) {
        when self {
            .Ok(_) then return true
            .Err(_) then return false
        }
    }

    /// `true` if the result is `Err`.
    pub fn bool is_err(self) {
        return not self.is_ok()
    }

    /// The success value; panics if the result is an error.
    @track_caller
    pub fn T unwrap(owned self) {
        when move self {
            .Ok(value) then return value
            .Err(_) then panic("called `Result.unwrap()` on an `Err` value")
        }
    }

    /// The error value; panics if the result is a success.
    @track_caller
    pub fn E unwrap_err(owned self) {
        when move self {
            .Ok(_) then panic("called `Result.unwrap_err()` on an `Ok` value")
            .Err(error) then return error
        }
    }

    /// The success value; panics with `message` if the result is an error.
    @track_caller
    pub fn T expect(owned self, String message) {
        when move self {
            .Ok(value) then return value
            .Err(_) then panic(message)
        }
    }

    /// The success value, or `default` if the result is an error.
    pub fn T unwrap_or(owned self, owned T default) {
        when move self {
            .Ok(value) then return value
            .Err(_) then return default
        }
    }

    /// Converts into an `Option`, discarding the error.
    pub fn Option[T] ok(owned self) {
        when move self {
            .Ok(value) then return Some(value)
            .Err(_) then return None
        }
    }

    /// Converts into an `Option` of the error, discarding the success value.
    pub fn Option[E] err(owned self) {
        when move self {
            .Ok(_) then return None
            .Err(error) then return Some(error)
        }
    }
}

// ---------------------------------------------------------------------------
// Standard traits (spec §3.9). The compiler uses them for the operators on other
// types than the built-in ones (`==` is `Eq.eq`, `<` is `Ord.cmp`, `+` is `Add.add`),
// for formatting (`{x}` calls `Display.to_string`) and for `@derive`.

/// Equality: `a == b` and `a != b`.
@lang("eq")
pub interface Eq {
    fn bool eq(self, Self other)
}

/// The result of a comparison.
@lang("ordering")
@derive(Copy)
pub type Ordering = .Less | .Equal | .Greater

extend Ordering {
    /// The opposite order: `Less` becomes `Greater`.
    pub fn Ordering reverse(self) {
        return when self {
            .Less then Ordering.Greater
            .Equal then Ordering.Equal
            .Greater then Ordering.Less
        }
    }
}

/// Total order: `<`, `<=`, `>`, `>=`, sorting and binary search.
@lang("ord")
pub interface Ord is Eq {
    fn Ordering cmp(self, Self other)
}

/// An independent copy of a value.
@lang("clone")
pub interface Clone {
    fn Self clone(self)
}

/// Values duplicated bit for bit instead of moved (spec §3.7). A type is `Copy` by its
/// structure (primitive types, `Ptr`, function types, and compositions of them without
/// `drop` or `indirect`); the interface has no method and needs no `impl`. As a bound,
/// `T: Copy` (`T is Copy` in edition 1) lets a generic function copy its values.
@lang("copy")
pub interface Copy {
}

/// A value that can be moved to another task (ADR 0013). Satisfied by the structure of
/// the type, like `Copy`: every value it holds is `Transfer`. `Ptr` and anonymous
/// functions are not; a type that holds a `Ptr` declares it in reviewed code
/// (`unsafe impl Transfer for T {}`), as `String` and `Vec` do.
@lang("transfer")
pub interface Transfer {
}

/// A value that several tasks can read at the same time through borrows (ADR 0013).
/// Satisfied by the structure of the type: in safe code a read borrow never modifies
/// anything (no interior mutability). `Ptr` and anonymous functions are not `Share`.
@lang("share")
pub interface Share {
}

/// Text for users: `{x}` in a string, `print(x)`.
@lang("display")
pub interface Display {
    fn String to_string(self)
}

/// An error that can be shown to users (ADR 0015): the errors of `std` (`io.IoError`)
/// implement it. In a function that returns `Result[T, dyn Error]`, `?` stores any
/// such error in the `dyn Error` value (an allocation).
@lang("error")
pub interface Error is Display {
}

/// A 64-bit summary of the value, equal for equal values (hash tables).
@lang("hash")
pub interface Hash {
    fn u64 hash(self)
}

/// The default value of a type: zero, empty, `false`, `None`.
@lang("default")
pub interface Default {
    fn Self default()
}

/// `a + b`
@lang("add")
pub interface Add {
    fn Self add(self, Self other)
}

/// `a - b`
@lang("sub")
pub interface Sub {
    fn Self sub(self, Self other)
}

/// `a * b`
@lang("mul")
pub interface Mul {
    fn Self mul(self, Self other)
}

/// `a / b`
@lang("div")
pub interface Div {
    fn Self div(self, Self other)
}

/// `a % b`
@lang("rem")
pub interface Rem {
    fn Self rem(self, Self other)
}

/// `-a`
@lang("neg")
pub interface Neg {
    fn Self neg(self)
}

/// Mixes the bits of a 64-bit value (SplitMix64 finalizer): every input bit changes
/// about half of the output bits.
pub fn u64 hash_mix(u64 x) {
    var z = x +% 0x9E37_79B9_7F4A_7C15
    z = (z ^ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB
    return z ^ (z >> 31)
}

/// Combines two hashes (order matters).
pub fn u64 hash_combine(u64 h, u64 x) {
    return hash_mix(h ^ (x +% 0x9E37_79B9_7F4A_7C15 +% (h << 6) +% (h >> 2)))
}

extend i8 is Eq {
    fn bool eq(self, i8 other) {
        return self == other
    }
}

extend i8 is Clone {
    fn i8 clone(self) {
        return self
    }
}

extend i8 is Display {
    fn String to_string(self) {
        return self.to_string()
    }
}

extend i8 is Ord {
    fn Ordering cmp(self, i8 other) {
        if self < other {
            return Ordering.Less
        }
        if self > other {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

extend i8 is Hash {
    fn u64 hash(self) {
        let x = self as i64
        let bits = if x < 0 { ~((0 - (x + 1)) as u64) } else { x as u64 }
        return hash_mix(bits)
    }
}

extend i8 is Default {
    fn i8 default() {
        return 0
    }
}

