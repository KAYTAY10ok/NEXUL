impl Ord for char {
    fn cmp(self, other: char) -> Ordering {
        if self < other {
            return Ordering.Less
        }
        if self > other {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

impl Hash for char {
    fn hash(self) -> u64 {
        return hash_mix((self as u32) as u64)
    }
}

impl Default for char {
    fn default() -> char {
        return (0 as u32) as char
    }
}

