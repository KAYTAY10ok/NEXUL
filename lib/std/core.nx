        }
        if self > other {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

extend char is Hash {
    fn u64 hash(self) {
        return hash_mix((self as u32) as u64)
    }
}

extend char is Default {
    fn char default() {
        return (0 as u32) as char
    }
}

