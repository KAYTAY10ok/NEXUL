impl Mul for usize {
    fn mul(self, other: usize) -> usize {
        return self * other
    }
}

impl Div for usize {
    fn div(self, other: usize) -> usize {
        return self / other
    }
}

impl Rem for usize {
    fn rem(self, other: usize) -> usize {
        return self % other
    }
}

impl Add for f32 {
    fn add(self, other: f32) -> f32 {
        return self + other
    }
}

impl Sub for f32 {
    fn sub(self, other: f32) -> f32 {
        return self - other
    }
}

impl Mul for f32 {
    fn mul(self, other: f32) -> f32 {
        return self * other
    }
}

impl Div for f32 {
    fn div(self, other: f32) -> f32 {
        return self / other
    }
}

impl Rem for f32 {
    fn rem(self, other: f32) -> f32 {
        return self % other
    }
}

impl Neg for f32 {
    fn neg(self) -> f32 {
        return -self
    }
}

impl Add for f64 {
    fn add(self, other: f64) -> f64 {
        return self + other
    }
}

impl Sub for f64 {
    fn sub(self, other: f64) -> f64 {
        return self - other
    }
}

impl Mul for f64 {
    fn mul(self, other: f64) -> f64 {
        return self * other
    }
}

impl Div for f64 {
    fn div(self, other: f64) -> f64 {
        return self / other
    }
}

impl Rem for f64 {
    fn rem(self, other: f64) -> f64 {
        return self % other
    }
}

impl Neg for f64 {
    fn neg(self) -> f64 {
        return -self
    }
}

impl Eq for Option[T: Eq] {
    fn eq(self, other: Self) -> bool {
        match self {
            Some(a) => {
                match other {
                    Some(b) => { return a == b }
                    None => { return false }
                }
            }
            None => { return other.is_none() }
        }
    }
}

impl Ord for Option[T: Ord] {
    fn cmp(self, other: Self) -> Ordering {
        match self {
            Some(a) => {
                match other {
                    Some(b) => { return a.cmp(b) }
                    None => { return Ordering.Greater }
                }
            }
            None => { return if other.is_none() { Ordering.Equal } else { Ordering.Less } }
        }
    }
}

impl Clone for Option[T: Clone] {
    fn clone(self) -> Self {
        match self {
            Some(a) => { return Some(a.clone()) }
            None => { return None }
        }
    }
}

impl Display for Option[T: Display] {
    fn to_string(self) -> String {
        match self {
            Some(a) => { return "Some({a})" }
            None => { return "None" }
        }
    }
}

impl Hash for Option[T: Hash] {
    fn hash(self) -> u64 {
        match self {
            Some(a) => { return hash_combine(1, a.hash()) }
            None => { return hash_mix(0) }
        }
    }
}

impl Default for Option[T] {
    fn default() -> Self {
        return None
    }
}

impl Eq for Result[T: Eq, E: Eq] {
    fn eq(self, other: Self) -> bool {
        match self {
            Ok(a) => {
                match other {
                    Ok(b) => { return a == b }
                    Err(_) => { return false }
                }
            }
            Err(a) => {
                match other {
                    Ok(_) => { return false }
                    Err(b) => { return a == b }
                }
            }
        }
    }
}

impl Clone for Result[T: Clone, E: Clone] {
    fn clone(self) -> Self {
        match self {
            Ok(a) => { return Ok(a.clone()) }
            Err(e) => { return Err(e.clone()) }
        }
    }
}

impl Display for Result[T: Display, E: Display] {
    fn to_string(self) -> String {
        match self {
            Ok(a) => { return "Ok({a})" }
            Err(e) => { return "Err({e})" }
        }
    }
}
