/// Core types of NEXUL: `Option` and `Result` (spec chapter 07).

import std.mem

/// An optional value: either `Some(value)` or `None`.
@lang("option")
@derive(Copy)
pub enum Option[T] {
    Some(T)
    None
}

impl Option {
    /// `true` if the option contains a value.
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => return true
            None => return false
        }
    }

    /// `true` if the option is `None`.
    pub fn is_none(self) -> bool {
        return not self.is_some()
    }

    /// The contained value; panics if the option is `None`.
    @track_caller
    pub fn unwrap(owned self) -> T {
        match move self {
            Some(value) => return value
            None => panic("called `Option.unwrap()` on a `None` value")
        }
    }

    /// The contained value; panics with `message` if the option is `None`.
    @track_caller
    pub fn expect(owned self, message: String) -> T {
        match move self {
            Some(value) => return value
            None => panic(message)
        }
    }

    /// The contained value, or `default` if the option is `None`.
    pub fn unwrap_or(owned self, owned default: T) -> T {
        match move self {
            Some(value) => return value
            None => return default
        }
    }

    /// Takes the value out of the option, leaving `None` in its place.
    pub fn take(inout self) -> Option[T] {
        return mem.replace(&self, None)
    }
}

/// The result of an operation that can fail: `Ok(value)` or `Err(error)`.
@lang("result")
@derive(Copy)
pub enum Result[T, E] {
    Ok(T)
    Err(E)
}

impl Result {
    /// `true` if the result is `Ok`.
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => return true
            Err(_) => return false
        }
    }

    /// `true` if the result is `Err`.
    pub fn is_err(self) -> bool {
        return not self.is_ok()
    }

    /// The success value; panics if the result is an error.
    @track_caller
    pub fn unwrap(owned self) -> T {
        match move self {
            Ok(value) => return value
            Err(_) => panic("called `Result.unwrap()` on an `Err` value")
        }
    }

    /// The error value; panics if the result is a success.
    @track_caller
    pub fn unwrap_err(owned self) -> E {
        match move self {
            Ok(_) => panic("called `Result.unwrap_err()` on an `Ok` value")
            Err(error) => return error
        }
    }

    /// The success value; panics with `message` if the result is an error.
    @track_caller
    pub fn expect(owned self, message: String) -> T {
        match move self {
            Ok(value) => return value
            Err(_) => panic(message)
        }
    }

    /// The success value, or `default` if the result is an error.
    pub fn unwrap_or(owned self, owned default: T) -> T {
        match move self {
            Ok(value) => return value
            Err(_) => return default
        }
    }

    /// Converts into an `Option`, discarding the error.
    pub fn ok(owned self) -> Option[T] {
        match move self {
            Ok(value) => return Some(value)
            Err(_) => return None
        }
    }

    /// Converts into an `Option` of the error, discarding the success value.
    pub fn err(owned self) -> Option[E] {
        match move self {
            Ok(_) => return None
            Err(error) => return Some(error)
        }
    }
}

// ---------------------------------------------------------------------------
// Standard traits (spec §3.9). The compiler uses them for the operators on other
// types than the built-in ones (`==` is `Eq.eq`, `<` is `Ord.cmp`, `+` is `Add.add`),
// for formatting (`{x}` calls `Display.to_string`) and for `@derive`.

/// Equality: `a == b` and `a != b`.
@lang("eq")
pub trait Eq {
    fn eq(self, other: Self) -> bool
}

/// The result of a comparison.
@lang("ordering")
@derive(Copy)
pub enum Ordering {
    Less
    Equal
    Greater
}

impl Ordering {
    /// The opposite order: `Less` becomes `Greater`.
    pub fn reverse(self) -> Ordering {
        return match self {
            Less => Ordering.Greater
            Equal => Ordering.Equal
            Greater => Ordering.Less
        }
    }
}

/// Total order: `<`, `<=`, `>`, `>=`, sorting and binary search.
@lang("ord")
pub trait Ord: Eq {
    fn cmp(self, other: Self) -> Ordering
}

/// An independent copy of a value.
@lang("clone")
pub trait Clone {
    fn clone(self) -> Self
}

/// Values duplicated bit for bit instead of moved (spec §3.7). A type is `Copy` by its
/// structure (primitive types, `Ptr`, function types, and compositions of them without
/// `drop` or `indirect`); the interface has no method and needs no `impl`. As a bound,
/// `T: Copy` (`T is Copy` in edition 1) lets a generic function copy its values.
@lang("copy")
pub trait Copy {
}

/// Text for users: `{x}` in a string, `print(x)`.
@lang("display")
pub trait Display {
    fn to_string(self) -> String
}

/// An error that can be shown to users (ADR 0015): the errors of `std` (`io.IoError`)
/// implement it. In a function that returns `Result[T, dyn Error]`, `?` stores any
/// such error in the `dyn Error` value (an allocation).
@lang("error")
pub trait Error: Display {
}

/// A 64-bit summary of the value, equal for equal values (hash tables).
@lang("hash")
pub trait Hash {
    fn hash(self) -> u64
}

/// The default value of a type: zero, empty, `false`, `None`.
@lang("default")
pub trait Default {
    fn default() -> Self
}

/// `a + b`
@lang("add")
pub trait Add {
    fn add(self, other: Self) -> Self
}

/// `a - b`
@lang("sub")
pub trait Sub {
    fn sub(self, other: Self) -> Self
}

/// `a * b`
@lang("mul")
pub trait Mul {
    fn mul(self, other: Self) -> Self
}

/// `a / b`
@lang("div")
pub trait Div {
    fn div(self, other: Self) -> Self
}

/// `a % b`
@lang("rem")
pub trait Rem {
    fn rem(self, other: Self) -> Self
}

/// `-a`
@lang("neg")
pub trait Neg {
    fn neg(self) -> Self
}

/// Mixes the bits of a 64-bit value (SplitMix64 finalizer): every input bit changes
/// about half of the output bits.
pub fn hash_mix(x: u64) -> u64 {
    var z = x +% 0x9E37_79B9_7F4A_7C15
    z = (z ^ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB
    return z ^ (z >> 31)
}

/// Combines two hashes (order matters).
pub fn hash_combine(h: u64, x: u64) -> u64 {
    return hash_mix(h ^ (x +% 0x9E37_79B9_7F4A_7C15 +% (h << 6) +% (h >> 2)))
}

impl Eq for i8 {
    fn eq(self, other: i8) -> bool {
        return self == other
    }
}

impl Clone for i8 {
    fn clone(self) -> i8 {
        return self
    }
}

impl Display for i8 {
    fn to_string(self) -> String {
        return self.to_string()
    }
}

impl Ord for i8 {
    fn cmp(self, other: i8) -> Ordering {
        if self < other {
            return Ordering.Less
        }
        if self > other {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

impl Hash for i8 {
    fn hash(self) -> u64 {
        let x = self as i64
        let bits = if x < 0 { ~((0 - (x + 1)) as u64) } else { x as u64 }
        return hash_mix(bits)
    }
}

impl Default for i8 {
    fn default() -> i8 {
        return 0
    }
}

