impl Eq for bool {
    fn eq(self, other: bool) -> bool {
        return self == other
    }
}

impl Clone for bool {
    fn clone(self) -> bool {
        return self
    }
}

impl Display for bool {
    fn to_string(self) -> String {
        return self.to_string()
    }
}

impl Ord for bool {
    fn cmp(self, other: bool) -> Ordering {
        if self == other {
            return Ordering.Equal
        }
        return if self { Ordering.Greater } else { Ordering.Less }
    }
}

impl Hash for bool {
    fn hash(self) -> u64 {
        return hash_mix(if self { 1 } else { 0 })
    }
}

impl Default for bool {
    fn default() -> bool {
        return false
    }
}

impl Eq for char {
    fn eq(self, other: char) -> bool {
        return self == other
    }
