extend bool is Eq {
    fn bool eq(self, bool other) {
        return self == other
    }
}

extend bool is Clone {
    fn bool clone(self) {
        return self
    }
}

extend bool is Display {
    fn String to_string(self) {
        return self.to_string()
    }
}

extend bool is Ord {
    fn Ordering cmp(self, bool other) {
        if self == other {
            return Ordering.Equal
        }
        return if self { Ordering.Greater } else { Ordering.Less }
    }
}

extend bool is Hash {
    fn u64 hash(self) {
        return hash_mix(if self { 1 } else { 0 })
    }
}

extend bool is Default {
    fn bool default() {
        return false
    }
}

extend char is Eq {
