extend usize is Rem {
    fn usize rem(self, usize other) {
        return self % other
    }
}

extend f32 is Add {
    fn f32 add(self, f32 other) {
        return self + other
    }
}

extend f32 is Sub {
    fn f32 sub(self, f32 other) {
        return self - other
    }
}

extend f32 is Mul {
    fn f32 mul(self, f32 other) {
        return self * other
    }
}

extend f32 is Div {
    fn f32 div(self, f32 other) {
        return self / other
    }
}

extend f32 is Rem {
    fn f32 rem(self, f32 other) {
        return self % other
    }
}

extend f32 is Neg {
    fn f32 neg(self) {
        return -self
    }
}

extend f64 is Add {
    fn f64 add(self, f64 other) {
        return self + other
    }
}

extend f64 is Sub {
    fn f64 sub(self, f64 other) {
        return self - other
    }
}

extend f64 is Mul {
    fn f64 mul(self, f64 other) {
        return self * other
    }
}

extend f64 is Div {
    fn f64 div(self, f64 other) {
        return self / other
    }
}

extend f64 is Rem {
    fn f64 rem(self, f64 other) {
        return self % other
    }
}

extend f64 is Neg {
    fn f64 neg(self) {
        return -self
    }
}

extend Option[T is Eq] is Eq {
    fn bool eq(self, Self other) {
        when self {
            .Some(a) then {
                when other {
                    .Some(b) then { return a == b }
                    .None then { return false }
                }
            }
            .None then { return other.is_none() }
        }
    }
}

extend Option[T is Ord] is Ord {
    fn Ordering cmp(self, Self other) {
        when self {
            .Some(a) then {
                when other {
                    .Some(b) then { return a.cmp(b) }
                    .None then { return Ordering.Greater }
                }
            }
            .None then { return if other.is_none() { Ordering.Equal } else { Ordering.Less } }
        }
    }
}

extend Option[T is Clone] is Clone {
    fn Self clone(self) {
        when self {
            .Some(a) then { return Some(a.clone()) }
            .None then { return None }
        }
    }
}

extend Option[T is Display] is Display {
    fn String to_string(self) {
        when self {
            .Some(a) then { return "Some({a})" }
            .None then { return "None" }
        }
    }
}

extend Option[T is Hash] is Hash {
    fn u64 hash(self) {
        when self {
            .Some(a) then { return hash_combine(1, a.hash()) }
            .None then { return hash_mix(0) }
        }
    }
}

extend Option[T] is Default {
    fn Self default() {
        return None
    }
}

extend Result[T is Eq, E is Eq] is Eq {
    fn bool eq(self, Self other) {
        when self {
            .Ok(a) then {
                when other {
                    .Ok(b) then { return a == b }
                    .Err(_) then { return false }
                }
            }
            .Err(a) then {
                when other {
                    .Ok(_) then { return false }
                    .Err(b) then { return a == b }
                }
            }
        }
    }
}

extend Result[T is Clone, E is Clone] is Clone {
    fn Self clone(self) {
        when self {
            .Ok(a) then { return Ok(a.clone()) }
            .Err(e) then { return Err(e.clone()) }
        }
    }
}

extend Result[T is Display, E is Display] is Display {
    fn String to_string(self) {
        when self {
            .Ok(a) then { return "Ok({a})" }
            .Err(e) then { return "Err({e})" }
        }
    }
}
