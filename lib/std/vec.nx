// edition: 1
/// A growable array stored on the heap (spec chapter 09).

import std.core
import std.mem
import std.rt

@lang("vec")
pub type Vec[T] {
    Ptr[T] data
    usize len
    usize cap
}

extend Vec {
    /// An empty vector (no allocation).
    pub fn Vec[T] new() {
        return Vec(data: Ptr.null(), len: 0, cap: 0)
    }

    /// An empty vector able to hold `capacity` elements without reallocating.
    pub fn Vec[T] with_capacity(usize capacity) {
        var Vec[T] v = Vec.new()
        v.reserve(capacity)
        return v
    }

    /// Number of elements.
    pub fn usize len(self) {
        return self.len
    }

    /// Number of elements that fit without reallocating.
    pub fn usize capacity(self) {
        return self.cap
    }

    pub fn bool is_empty(self) {
        return self.len == 0
    }

    /// Makes room for `extra` more elements (capacity grows geometrically).
    pub fn reserve(self!, usize extra) {
        let need = self.len + extra
        if need <= self.cap {
            return
        }
        var usize cap = if self.cap == 0 { 4 } else { self.cap * 2 }
        if cap < need {
            cap = need
        }
        let size = cap * mem.size_of[T]()
        unsafe {
            if self.cap == 0 {
                self.data = mem.alloc(size).cast[T]()
            } else {
                self.data = mem.realloc(self.data.cast[u8](), size).cast[T]()
            }
        }
        self.cap = cap
    }

    /// Appends an element.
    pub fn push(self!, owned T value) {
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            self.data.offset(self.len).write(value)
        }
        self.len += 1
    }

    /// Removes and returns the last element.
    pub fn Option[T] pop(self!) {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        unsafe {
            return Some(self.data.offset(self.len).read())
        }
    }

    /// Inserts an element at `index`, shifting the following ones.
    @track_caller
    pub fn insert(self!, usize index, owned T value) {
        if index > self.len {
            panic("insertion index {index} is out of bounds of a vector of length {self.len}")
        }
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            let p = self.data.offset(index)
            mem.copy(p, p.offset(1), self.len - index)
            p.write(value)
        }
        self.len += 1
    }

    /// Removes and returns the element at `index`, shifting the following ones.
    @track_caller
    pub fn T remove(self!, usize index) {
        if index >= self.len {
            panic("removal index {index} is out of bounds of a vector of length {self.len}")
        }
        unsafe {
            let p = self.data.offset(index)
            let value = p.read()
            mem.copy(p.offset(1), p, self.len - index - 1)
            self.len -= 1
            return value
        }
    }

    /// Exchanges the elements at `i` and `j`.
    @track_caller
    pub fn swap(self!, usize i, usize j) {
        if i >= self.len or j >= self.len {
            panic("swap index out of bounds: the length is {self.len} but the indices are {i} and {j}")
        }
        if i == j {
            return
        }
        unsafe {
            let a = self.data.offset(i)
            let b = self.data.offset(j)
            let tmp = a.read()
            a.write(b.read())
            b.write(tmp)
        }
    }

    /// Removes every element.
    pub fn clear(self!) {
        self.truncate(0)
    }

    /// Keeps the first `length` elements and destroys the others, by increasing index
    /// (spec §5.5).
    pub fn truncate(self!, usize length) {
        if length >= self.len {
            return
        }
        let old = self.len
        self.len = length
        for i in length..old {
            unsafe {
                mem.drop_in_place(self.data.offset(i))
            }
        }
    }

    /// Address of the first element (null for an empty vector without storage). The
    /// pointer is valid until the vector is modified or destroyed.
    pub fn Ptr[T] as_ptr(self) {
        return self.data
    }

    /// Sets the length without initializing or destroying elements: the elements
    /// `0..length` must be valid and `length <= capacity()`.
    pub unsafe fn set_len(self!, usize length) {
        self.len = length
    }

    /// Gives up the storage: (data, length, capacity). The caller becomes responsible
    /// for the elements and for freeing the storage with `mem.free`.
    pub unsafe fn (Ptr[T], usize, usize) into_raw_parts(owned self) {
        let parts = (self.data, self.len, self.cap)
        mem.forget(self)
        return parts
    }

    /// Address of element `index` (used by `v[index]`).
    @index
    @track_caller
    fn Ptr[T] at(self, usize index) {
        if index >= self.len {
            rt.index_fail(index, self.len)
        }
        unsafe {
            return self.data.offset(index)
        }
    }

    fn drop(self!) {
        self.truncate(0)
        if self.cap > 0 {
            unsafe {
                mem.free(self.data.cast[u8]())
            }
        }
    }
}

extend Vec {
    /// Reverses the order of the elements.
    pub fn reverse(self!) {
        var usize i = 0
        var j = self.len
        while i + 1 < j {
            j -= 1
            self.swap(i, j)
            i += 1
        }
    }

    /// Sorts the elements with a comparison function.
    pub fn sort_by(self!, fn Ordering(T, T) compare) {
        let n = self.len
        if n < 2 {
            return
        }
        var start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down_by(start, n, compare)
        }
        var end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            self.sift_down_by(0, end, compare)
        }
    }

    fn sift_down_by(self!, usize start, usize end, fn Ordering(T, T) compare) {
        var root = start
        loop {
            let child = 2 * root + 1
            if child >= end {
                return
            }
            var c = child
            if child + 1 < end and compare(self[child], self[child + 1]) == Ordering.Less {
                c = child + 1
            }
            if compare(self[root], self[c]) == Ordering.Less {
                self.swap(root, c)
                root = c
            } else {
                return
            }
        }
    }

    /// A new vector with `f` applied to every element.
    pub fn Vec[U] map[U](self, fn U(T) f) {
        var Vec[U] out = Vec.with_capacity(self.len)
        for x in self {
            out.push(f(x))
        }
        return out
    }

    /// Calls `f` on every element, in order.
    pub fn for_each(self, fn(T) f) {
        for x in self {
            f(x)
        }
    }

    /// `true` if `test` is true for at least one element.
    pub fn bool any(self, fn bool(T) test_) {
        for x in self {
            if test_(x) {
                return true
            }
        }
        return false
    }

    /// `true` if `test` is true for every element.
    pub fn bool all(self, fn bool(T) test_) {
        for x in self {
            if not test_(x) {
                return false
            }
        }
        return true
    }

    /// The number of elements for which `test` is true.
    pub fn usize count(self, fn bool(T) test_) {
        var usize n = 0
        for x in self {
            if test_(x) {
                n += 1
            }
        }
        return n
    }

    /// The position of the first element for which `test` is true.
    pub fn Option[usize] position(self, fn bool(T) test_) {
        for i in 0..self.len {
            if test_(self[i]) {
                return Some(i)
            }
        }
        return None
    }

    /// Combines the elements from left to right: `f(f(f(init, a), b), c)`.
    pub fn A fold[A](self, owned A init, fn A(A, T) f) {
        var acc = init
        for x in self {
            acc = f(acc, x)
        }
        return acc
    }

    /// Keeps only the elements for which `keep` is true.
    pub fn retain(self!, fn bool(T) keep) {
        var usize i = 0
        while i < self.len {
            if keep(self[i]) {
                i += 1
            } else {
                let _ = self.remove(i)
            }
        }
    }
}

extend Vec[T is Eq] {
    /// `true` if an element equals `value`.
    pub fn bool contains(self, T value) {
        for x in self {
            if x == value {
                return true
            }
        }
        return false
    }

    /// The position of the first element equal to `value`.
    pub fn Option[usize] index_of(self, T value) {
        for i in 0..self.len {
            if self[i] == value {
                return Some(i)
            }
        }
        return None
    }

    /// Removes consecutive equal elements.
    pub fn dedup(self!) {
        var usize i = 1
        while i < self.len {
            if self[i] == self[i - 1] {
                let _ = self.remove(i)
            } else {
                i += 1
            }
        }
    }
}

extend Vec[T is Clone] {
    /// A copy of the first element, or `None` if the vector is empty.
    pub fn Option[T] first(self) {
        if self.len == 0 {
            return None
        }
        return Some(self[0].clone())
    }

    /// A copy of the last element, or `None` if the vector is empty.
    pub fn Option[T] last(self) {
        if self.len == 0 {
            return None
        }
        return Some(self[self.len - 1].clone())
    }

    /// A new vector with the elements for which `keep` is true.
    pub fn Vec[T] filter(self, fn bool(T) keep) {
        var Vec[T] out = Vec.new()
        for x in self {
            if keep(x) {
                out.push(x.clone())
            }
        }
        return out
    }

    /// A copy of the first element for which `test` is true.
    pub fn Option[T] find(self, fn bool(T) test_) {
        for x in self {
            if test_(x) {
                return Some(x.clone())
            }
        }
        return None
    }

    /// Appends copies of the elements of `other`.
    pub fn extend(self!, Vec[T] other) {
        self.reserve(other.len)
        for x in other {
            self.push(x.clone())
        }
    }
}

extend Vec[T is Ord] {
    /// Sorts the elements in increasing order (heap sort: O(n log n), in place; equal
    /// elements may change order).
    pub fn sort(self!) {
        let n = self.len
        if n < 2 {
            return
        }
        var start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down(start, n)
        }
        var end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            self.sift_down(0, end)
        }
    }

    fn sift_down(self!, usize start, usize end) {
        var root = start
        loop {
            let child = 2 * root + 1
            if child >= end {
                return
            }
            var c = child
            if child + 1 < end and self[child] < self[child + 1] {
                c = child + 1
            }
            if self[root] < self[c] {
                self.swap(root, c)
                root = c
            } else {
                return
            }
        }
    }

    /// The position of `value` in a sorted vector (binary search).
    pub fn Option[usize] binary_search(self, T value) {
        var usize lo = 0
        var hi = self.len
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            let c = self[mid].cmp(value)
            if c == Ordering.Equal {
                return Some(mid)
            }
            if c == Ordering.Less {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return None
    }
}

extend Vec[T is Ord and Clone] {
    /// A copy of the largest element.
    pub fn Option[T] max(self) {
        if self.len == 0 {
            return None
        }
        var usize best = 0
        for i in 1..self.len {
            if self[i] > self[best] {
                best = i
            }
        }
        return Some(self[best].clone())
    }

    /// A copy of the smallest element.
    pub fn Option[T] min(self) {
        if self.len == 0 {
            return None
        }
        var usize best = 0
        for i in 1..self.len {
            if self[i] < self[best] {
                best = i
            }
        }
        return Some(self[best].clone())
    }
}

extend Vec[T is Add and Default] {
    /// The sum of the elements (`T.default()` for an empty vector).
    pub fn T sum(self) {
        var total = T.default()
        for x in self {
            total = total + x
        }
        return total
    }
}

extend Vec[T is Display] {
    /// The elements as text, separated by `separator`.
    pub fn String join(self, String separator) {
        var out = ""
        for i in 0..self.len {
            if i > 0 {
                out.push_str(separator)
            }
            out.push_str(self[i].to_string())
        }
        return out
    }
}

// ---------------------------------------------------------------------------
// Standard traits

extend Vec[T is Clone] is Clone {
    fn Vec[T] clone(self) {
        var Vec[T] out = Vec.with_capacity(self.len)
        for x in self {
            out.push(x.clone())
        }
        return out
    }
}

extend Vec[T is Eq] is Eq {
    fn bool eq(self, Vec[T] other) {
        if self.len != other.len {
            return false
        }
        for i in 0..self.len {
            if self[i] != other[i] {
                return false
            }
        }
        return true
    }
}

extend Vec[T is Ord] is Ord {
    /// Lexicographic order.
    fn Ordering cmp(self, Vec[T] other) {
        var usize i = 0
        while i < self.len and i < other.len {
            let c = self[i].cmp(other[i])
            if c != Ordering.Equal {
                return c
            }
            i += 1
        }
        if self.len < other.len {
            return Ordering.Less
        }
        if self.len > other.len {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

extend Vec[T is Display] is Display {
    fn String to_string(self) {
        return "[{self.join(", ")}]"
    }
}

extend Vec[T is Hash] is Hash {
    fn u64 hash(self) {
        var h = core.hash_mix(self.len as u64)
        for x in self {
            h = core.hash_combine(h, x.hash())
        }
        return h
    }
}

extend Vec[T] is Default {
    fn Vec[T] default() {
        return Vec.new()
    }
}

// ---------------------------------------------------------------------------
// Tasks (ADR 0013)

// The elements belong to the vector alone: it can be moved to another task when they
// can, and read by several tasks when they can.
unsafe extend Vec[T is Transfer] is Transfer {
}

unsafe extend Vec[T is Share] is Share {
}
