/// A growable array stored on the heap (spec chapter 09).

import std.core
import std.mem
import std.rt

@lang("vec")
pub struct Vec[T] {
    data: Ptr[T]
    len: usize
    cap: usize
}

impl Vec {
    /// An empty vector (no allocation).
    pub fn new() -> Vec[T] {
        return Vec(data: Ptr.null(), len: 0, cap: 0)
    }

    /// An empty vector able to hold `capacity` elements without reallocating.
    pub fn with_capacity(capacity: usize) -> Vec[T] {
        var v: Vec[T] = Vec.new()
        v.reserve(capacity)
        return v
    }

    /// Number of elements.
    pub fn len(self) -> usize {
        return self.len
    }

    /// Number of elements that fit without reallocating.
    pub fn capacity(self) -> usize {
        return self.cap
    }

    pub fn is_empty(self) -> bool {
        return self.len == 0
    }

    /// Makes room for `extra` more elements (capacity grows geometrically).
    pub fn reserve(inout self, extra: usize) {
        let need = self.len + extra
        if need <= self.cap {
            return
        }
        var cap: usize = if self.cap == 0 { 4 } else { self.cap * 2 }
        if cap < need {
            cap = need
        }
        let size = cap * mem.size_of[T]()
        unsafe {
            if self.cap == 0 {
                self.data = mem.alloc(size).cast[T]()
            } else {
                self.data = mem.realloc(self.data.cast[u8](), size).cast[T]()
            }
        }
        self.cap = cap
    }

    /// Appends an element.
    pub fn push(inout self, owned value: T) {
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            self.data.offset(self.len).write(value)
        }
        self.len += 1
    }

    /// Removes and returns the last element.
    pub fn pop(inout self) -> Option[T] {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        unsafe {
            return Some(self.data.offset(self.len).read())
        }
    }

    /// Inserts an element at `index`, shifting the following ones.
    @track_caller
    pub fn insert(inout self, index: usize, owned value: T) {
        if index > self.len {
            panic("insertion index {index} is out of bounds of a vector of length {self.len}")
        }
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            let p = self.data.offset(index)
            mem.copy(p, p.offset(1), self.len - index)
            p.write(value)
        }
        self.len += 1
    }

    /// Removes and returns the element at `index`, shifting the following ones.
    @track_caller
    pub fn remove(inout self, index: usize) -> T {
        if index >= self.len {
            panic("removal index {index} is out of bounds of a vector of length {self.len}")
        }
        unsafe {
            let p = self.data.offset(index)
            let value = p.read()
            mem.copy(p.offset(1), p, self.len - index - 1)
            self.len -= 1
            return value
        }
    }

    /// Exchanges the elements at `i` and `j`.
    @track_caller
    pub fn swap(inout self, i: usize, j: usize) {
        if i >= self.len or j >= self.len {
            panic("swap index out of bounds: the length is {self.len} but the indices are {i} and {j}")
        }
        if i == j {
            return
        }
        unsafe {
            let a = self.data.offset(i)
            let b = self.data.offset(j)
            let tmp = a.read()
            a.write(b.read())
            b.write(tmp)
        }
    }

    /// Removes every element.
    pub fn clear(inout self) {
        self.truncate(0)
    }

    /// Keeps the first `length` elements and destroys the others, by increasing index
    /// (spec §5.5).
    pub fn truncate(inout self, length: usize) {
        if length >= self.len {
            return
        }
        let old = self.len
        self.len = length
        for i in length..old {
            unsafe {
                mem.drop_in_place(self.data.offset(i))
            }
        }
    }

    /// Address of the first element (null for an empty vector without storage). The
    /// pointer is valid until the vector is modified or destroyed.
    pub fn as_ptr(self) -> Ptr[T] {
        return self.data
    }

    /// Sets the length without initializing or destroying elements: the elements
    /// `0..length` must be valid and `length <= capacity()`.
    pub unsafe fn set_len(inout self, length: usize) {
        self.len = length
    }

    /// Gives up the storage: (data, length, capacity). The caller becomes responsible
    /// for the elements and for freeing the storage with `mem.free`.
    pub unsafe fn into_raw_parts(owned self) -> (Ptr[T], usize, usize) {
        let parts = (self.data, self.len, self.cap)
        mem.forget(self)
        return parts
    }

    /// Address of element `index` (used by `v[index]`).
    @index
    @track_caller
    fn at(self, index: usize) -> Ptr[T] {
        if index >= self.len {
            rt.index_fail(index, self.len)
        }
        unsafe {
            return self.data.offset(index)
        }
    }

    fn drop(inout self) {
        self.truncate(0)
        if self.cap > 0 {
            unsafe {
                mem.free(self.data.cast[u8]())
            }
        }
    }
}

impl Vec {
    /// `true` if an element equals `value`.
    pub fn contains(self, value: T) -> bool where T: Eq {
        for x in self {
            if x == value {
                return true
            }
        }
        return false
    }

    /// The position of the first element equal to `value`.
    pub fn index_of(self, value: T) -> Option[usize] where T: Eq {
        for i in 0..self.len {
            if self[i] == value {
                return Some(i)
            }
        }
        return None
    }

    /// A copy of the first element, or `None` if the vector is empty.
    pub fn first(self) -> Option[T] where T: Clone {
        if self.len == 0 {
            return None
        }
        return Some(self[0].clone())
    }

    /// A copy of the last element, or `None` if the vector is empty.
    pub fn last(self) -> Option[T] where T: Clone {
        if self.len == 0 {
            return None
        }
        return Some(self[self.len - 1].clone())
    }

    /// Reverses the order of the elements.
    pub fn reverse(inout self) {
        var i: usize = 0
        var j = self.len
        while i + 1 < j {
            j -= 1
            self.swap(i, j)
            i += 1
        }
    }

    /// Sorts the elements in increasing order (heap sort: O(n log n), in place; equal
    /// elements may change order).
    pub fn sort(inout self) where T: Ord {
        let n = self.len
        if n < 2 {
            return
        }
        var start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down(start, n)
        }
        var end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            self.sift_down(0, end)
        }
    }

    fn sift_down(inout self, start: usize, end: usize) where T: Ord {
        var root = start
        while true {
            let child = 2 * root + 1
            if child >= end {
                return
            }
            var c = child
            if child + 1 < end and self[child] < self[child + 1] {
                c = child + 1
            }
            if self[root] < self[c] {
                self.swap(root, c)
                root = c
            } else {
                return
            }
        }
    }

    /// Sorts the elements with a comparison function.
    pub fn sort_by(inout self, compare: fn(T, T) -> Ordering) {
        let n = self.len
        if n < 2 {
            return
        }
        var start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down_by(start, n, compare)
        }
        var end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            self.sift_down_by(0, end, compare)
        }
    }

    fn sift_down_by(inout self, start: usize, end: usize, compare: fn(T, T) -> Ordering) {
        var root = start
        while true {
            let child = 2 * root + 1
            if child >= end {
                return
            }
            var c = child
            if child + 1 < end and compare(self[child], self[child + 1]) == Ordering.Less {
                c = child + 1
            }
            if compare(self[root], self[c]) == Ordering.Less {
                self.swap(root, c)
                root = c
            } else {
                return
            }
        }
    }

    /// The position of `value` in a sorted vector (binary search).
    pub fn binary_search(self, value: T) -> Option[usize] where T: Ord {
        var lo: usize = 0
        var hi = self.len
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            let c = self[mid].cmp(value)
            if c == Ordering.Equal {
                return Some(mid)
            }
            if c == Ordering.Less {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return None
    }

    /// A new vector with `f` applied to every element.
    pub fn map[U](self, f: fn(T) -> U) -> Vec[U] {
        var out: Vec[U] = Vec.with_capacity(self.len)
        for x in self {
            out.push(f(x))
        }
        return out
    }

    /// A new vector with the elements for which `keep` is true.
    pub fn filter(self, keep: fn(T) -> bool) -> Vec[T] where T: Clone {
        var out: Vec[T] = Vec.new()
        for x in self {
            if keep(x) {
                out.push(x.clone())
            }
        }
        return out
    }

    /// Calls `f` on every element, in order.
    pub fn for_each(self, f: fn(T)) {
        for x in self {
            f(x)
        }
    }

    /// `true` if `test` is true for at least one element.
    pub fn any(self, test: fn(T) -> bool) -> bool {
        for x in self {
            if test(x) {
                return true
            }
        }
        return false
    }

    /// `true` if `test` is true for every element.
    pub fn all(self, test: fn(T) -> bool) -> bool {
        for x in self {
            if not test(x) {
                return false
            }
        }
        return true
    }

    /// The number of elements for which `test` is true.
    pub fn count(self, test: fn(T) -> bool) -> usize {
        var n: usize = 0
        for x in self {
            if test(x) {
                n += 1
            }
        }
        return n
    }

    /// A copy of the first element for which `test` is true.
    pub fn find(self, test: fn(T) -> bool) -> Option[T] where T: Clone {
        for x in self {
            if test(x) {
                return Some(x.clone())
            }
        }
        return None
    }

    /// The position of the first element for which `test` is true.
    pub fn position(self, test: fn(T) -> bool) -> Option[usize] {
        for i in 0..self.len {
            if test(self[i]) {
                return Some(i)
            }
        }
        return None
    }

    /// Combines the elements from left to right: `f(f(f(init, a), b), c)`.
    pub fn fold[A](self, owned init: A, f: fn(A, T) -> A) -> A {
        var acc = init
        for x in self {
            acc = f(acc, x)
        }
        return acc
    }

    /// Keeps only the elements for which `keep` is true.
    pub fn retain(inout self, keep: fn(T) -> bool) {
        var i: usize = 0
        while i < self.len {
            if keep(self[i]) {
                i += 1
            } else {
                let _ = self.remove(i)
            }
        }
    }

    /// Removes consecutive equal elements.
    pub fn dedup(inout self) where T: Eq {
        var i: usize = 1
        while i < self.len {
            if self[i] == self[i - 1] {
                let _ = self.remove(i)
            } else {
                i += 1
            }
        }
    }

    /// A copy of the largest element.
    pub fn max(self) -> Option[T] where T: Ord + Clone {
        if self.len == 0 {
            return None
        }
        var best: usize = 0
        for i in 1..self.len {
            if self[i] > self[best] {
                best = i
            }
        }
        return Some(self[best].clone())
    }

    /// A copy of the smallest element.
    pub fn min(self) -> Option[T] where T: Ord + Clone {
        if self.len == 0 {
            return None
        }
        var best: usize = 0
        for i in 1..self.len {
            if self[i] < self[best] {
                best = i
            }
        }
        return Some(self[best].clone())
    }

    /// The sum of the elements (`T.default()` for an empty vector).
    pub fn sum(self) -> T where T: Add + Default {
        var total = T.default()
        for x in self {
            total = total + x
        }
        return total
    }

    /// The elements as text, separated by `separator`.
    pub fn join(self, separator: String) -> String where T: Display {
        var out = ""
        for i in 0..self.len {
            if i > 0 {
                out.push_str(separator)
            }
            out.push_str(self[i].to_string())
        }
        return out
    }

    /// Appends copies of the elements of `other`.
    pub fn extend(inout self, other: Vec[T]) where T: Clone {
        self.reserve(other.len)
        for x in other {
            self.push(x.clone())
        }
    }
}

// ---------------------------------------------------------------------------
// Standard traits

impl Clone for Vec[T: Clone] {
    fn clone(self) -> Vec[T] {
        var out: Vec[T] = Vec.with_capacity(self.len)
        for x in self {
            out.push(x.clone())
        }
        return out
    }
}

impl Eq for Vec[T: Eq] {
    fn eq(self, other: Vec[T]) -> bool {
        if self.len != other.len {
            return false
        }
        for i in 0..self.len {
            if self[i] != other[i] {
                return false
            }
        }
        return true
    }
}

impl Ord for Vec[T: Ord] {
    /// Lexicographic order.
    fn cmp(self, other: Vec[T]) -> Ordering {
        var i: usize = 0
        while i < self.len and i < other.len {
            let c = self[i].cmp(other[i])
            if c != Ordering.Equal {
                return c
            }
            i += 1
        }
        if self.len < other.len {
            return Ordering.Less
        }
        if self.len > other.len {
            return Ordering.Greater
        }
        return Ordering.Equal
    }
}

impl Display for Vec[T: Display] {
    fn to_string(self) -> String {
        return "[{self.join(", ")}]"
    }
}

impl Hash for Vec[T: Hash] {
    fn hash(self) -> u64 {
        var h = core.hash_mix(self.len as u64)
        for x in self {
            h = core.hash_combine(h, x.hash())
        }
        return h
    }
}

impl Default for Vec[T] {
    fn default() -> Vec[T] {
        return Vec.new()
    }
}
