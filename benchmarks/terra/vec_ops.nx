fn main() {
    let n: usize = 4000000
    var values: Vec[u64] = Vec.with_capacity(n)
    for i in 0..n {
        values.push((i % 1000) as u64)
    }
    for _ in 0..3 {
        for i in 0..n {
            values[i] = values[i] * 3 + 7
        }
    }
    var sum: u64 = 0
    for value in values {
        sum += value
    }
    println("{sum}")
}
