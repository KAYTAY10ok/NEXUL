fn main() {
    var o: Option[String] = Some("x")
    match &o {
        Some(s) => {
            println("{o.is_some()}")
            s.push('!')
        }
        None => {}
    }
    let fixed: Option[i32] = Some(1)
    if let Some(x) = &fixed {
        x += 1
    }
    var v: Vec[i32] = Vec.new()
    for e in &v {
        println("{v.len()}")
        e += 1
    }
    for c in &"abc" {
    }
    if let Some(y) = &Some(3) {
    }
}
