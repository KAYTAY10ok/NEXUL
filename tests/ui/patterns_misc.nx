enum E {
    A(i32, i32)
    B
}

struct S {
    x: i32
    y: i32
}

fn main() {
    let e = E.A(1, 2)
    match e {
        A(x) => println("{x}")
        B(y) => println("{y}")
        _ => println("other")
    }
    match e {
        A(a, a) => println("{a}")
        _ => {}
    }
    match 5 {
        1 | x => println("{x}")
    }
    let s = S(x: 1, y: 2)
    match s {
        S(x: 1) => println("one")
        S(x: _, z: 3) => println("z")
        _ => {}
    }
    match 5 {
        9..=1 => println("empty")
        _ => {}
    }
    let Some(v) = Some(1)
    for (a, b) in 0..3 {
    }
}
