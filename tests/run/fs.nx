// edition: 1
// targets: linux, windows, macos, wasi
// std.fs: paths, then a directory tree made, listed, renamed in and removed.
import std.fs
import std.io
import std.random

fn main() {
    // Paths, without the file system.
    println("{fs.join("a", "b.txt")} {fs.join("a/", "b")} {fs.join("a", "/b")} {fs.join("", "b")}")
    println("{fs.file_name("a/b/c.txt")} {fs.file_name("c")} {fs.file_name("a/b/")}")
    println("{fs.parent("a/b/c")} {fs.parent("/a")} {fs.parent("a")} {fs.parent("/")}")
    println("{fs.extension("a/b.tar.gz")} {fs.extension("a/b")} {fs.extension("a/.profile")}")

    // A directory of its own (the O0 and O2 runs are at the same time, in the same place).
    let root = "nexul_fs_" + random.secure_token(12)
    println("exists before: {fs.exists(root)}")
    when fs.create_dir_all(fs.join(root, "x/y")) {
        .Ok(_) then println("created")
        .Err(e) then println("error: {e}")
    }
    let _ = io.write_file(fs.join(root, "b.txt"), "hello")
    let _ = io.write_file(fs.join(root, "a.txt"), "")
    println("dir: {fs.is_dir(root)} {fs.is_dir(fs.join(root, "x/y"))} file: {fs.is_file(fs.join(root, "b.txt"))}")
    when fs.list_dir(root) {
        .Ok(names) then println("entries: {names}")
        .Err(e) then println("error: {e}")
    }
    when fs.metadata(fs.join(root, "b.txt")) {
        .Ok(m) then println("size {m.size}, file {m.is_file()}, dated {m.modified_ns > 1_000_000_000_000_000_000}")
        .Err(e) then println("error: {e}")
    }
    let _ = fs.rename(fs.join(root, "b.txt"), fs.join(root, "x/c.txt"))
    let _ = fs.copy(fs.join(root, "x/c.txt"), fs.join(root, "x/y/d.txt"))
    println("renamed: {fs.exists(fs.join(root, "b.txt"))} {io.read_file(fs.join(root, "x/y/d.txt"))}")
    when fs.remove_dir(root) {
        .Ok(_) then println("removed a full directory?")
        .Err(_) then println("not empty: refused")
    }
    when fs.metadata(fs.join(root, "none")) {
        .Ok(_) then println("found?")
        .Err(e) then println("missing: {e == io.IoError.NotFound(fs.join(root, "none"))}")
    }
    when fs.remove_dir_all(root) {
        .Ok(_) then println("all removed: {not fs.exists(root)}")
        .Err(e) then println("error: {e}")
    }
}
