// edition: 1
// The `else` fallback (ADR 0010 §6) and `in` (§3).

import std.collections.{Map, Set}

fn Result[i32, String] divise(i32 a, i32 b) {
    if b == 0 {
        return Err("division par zéro")
    }
    return Ok(a / b)
}

fn i64 somme(String texte) {
    // A block that leaves.
    let i64 n = texte.parse_int() else {
        return -1
    }
    return n + 1
}

type Compteur {
    i32 n
}

fn i32 deux() {
    println("deux() appelé")
    return 2
}

fn main() {
    let i64 a = "41".parse_int() else 0
    let i64 b = "x".parse_int() else 0
    println("{a} {b}")
    let i32 q = divise(7, 2) else -1
    let i32 r = divise(7, 0) else -1
    println("{q} {r}")
    println("{somme("9")} {somme("neuf")}")
    // A variable that owns its value gives it.
    let Option[String] nom = Some("Ada")
    let String n = nom else "inconnu"
    println(n)
    // As a statement: the fallback runs on an error.
    divise(1, 0) else println("échec signalé")
    divise(4, 2) else println("pas affiché")

    // `in`: intervals, the value read once.
    let i32 x = 5
    println("{x in 0..5} {x in 0..=5} {x in 1..10}")
    let c = Compteur(n: 3)
    println("{c.n in 3..4}")
    println("{deux() in 1..3}")
    // Collections.
    var Vec[i32] v = Vec.new()
    v.push(1)
    v.push(4)
    println("{4 in v} {5 in v}")
    println("{"ell" in "hello"}")
    var Set[String] s = Set.new()
    s.insert("a")
    var Map[String, i32] m = Map.new()
    m.insert("k", 1)
    println("{"a" in s} {"k" in m} {"z" in m}")
    if x in 0..10 and not (x in 6..9) {
        println("dans l'intervalle")
    }
}