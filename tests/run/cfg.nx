// Spec §6.8: conditional compilation.

@cfg("windows")
fn system() -> String {
    return "windows"
}

@cfg("linux")
fn system() -> String {
    return "linux"
}

@cfg("macos")
fn system() -> String {
    return "macos"
}

@cfg("wasi")
fn system() -> String {
    return "wasi"
}

@cfg("bare")
fn system() -> String {
    return "bare"
}

@cfg("!windows", "!linux", "!macos", "!wasi", "!bare")
fn system() -> String {
    return "other"
}

@cfg("windows|linux|macos|wasi|bare")
const KNOWN: bool = true

@cfg("!windows", "!linux", "!macos", "!wasi", "!bare")
const KNOWN: bool = false

struct Counter {
    value: i32
}

impl Counter {
    @cfg("debug")
    fn mode(self) -> String {
        return "debug"
    }

    @cfg("release")
    fn mode(self) -> String {
        return "release"
    }
}

fn main() {
    let s = system()
    println("known system: {KNOWN}, consistent: {s.len() > 0}")
    let c = Counter(value: 1)
    println("{c.value} {c.mode()}")
}
