// Spec chapter 04: control flow and patterns.
fn classify(n: i32) -> String {
    return match n {
        0 => "zero"
        1 | 2 | 3 => "small"
        4..=9 => "digit"
        x if x < 0 => "negative"
        _ => "large"
    }
}

fn grade(score: u32) -> char {
    let g = if score >= 90 {
        'A'
    } else if score >= 70 {
        'B'
    } else {
        'C'
    }
    return g
}

fn first_even(values: [i32; 5]) -> Option[i32] {
    for v in values {
        if v % 2 == 0 {
            return Some(v)
        }
    }
    return None
}

fn collatz(start: u64) -> u32 {
    var n = start
    var steps: u32 = 0
    while n != 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
        steps += 1
    }
    return steps
}

fn describe(p: (i32, bool)) -> String {
    return match p {
        (0, _) => "origin"
        (x, true) if x > 0 => "positive flagged"
        (_, true) => "flagged"
        (_, false) => "plain"
    }
}

fn main() {
    for n in [-5, 0, 2, 7, 42] {
        print("{classify(n)} ")
    }
    println()
    println("{grade(95)}{grade(75)}{grade(10)}")
    match first_even([1, 3, 6, 7, 8]) {
        Some(v) => println("first even: {v}")
        None => println("no even")
    }
    println("collatz(27) = {collatz(27)}")
    println("{describe((0, true))} {describe((3, true))} {describe((-3, true))} {describe((5, false))}")

    // Ranges: exclusive, inclusive, empty, up to the maximum value without overflow.
    var total = 0
    for i in 0..5 {
        total += i
    }
    for i in 5..=5 {
        total += i * 100
    }
    for _ in 3..1 {
        total += 1000
    }
    var count = 0
    for _ in 250..=u8.MAX {
        count += 1
    }
    println("total = {total}, count = {count}")

    // Labeled loops.
    var pairs = 0
    outer: for i in 0..10 {
        for j in 0..10 {
            if j > i {
                continue outer
            }
            if i == 5 {
                break outer
            }
            pairs += 1
        }
    }
    println("pairs = {pairs}")

    // while with break and continue.
    var k = 0
    var odd_sum = 0
    while true {
        k += 1
        if k > 9 {
            break
        }
        if k % 2 == 0 {
            continue
        }
        odd_sum += k
    }
    println("odd sum = {odd_sum}")

    // if let / else if let chains.
    let values: [Option[i32]; 3] = [None, Some(4), Some(-1)]
    for v in values {
        if let Some(x) = v {
            if x > 0 {
                println("positive {x}")
            } else {
                println("non-positive {x}")
            }
        } else {
            println("none")
        }
    }

    // Booleans and short-circuit evaluation.
    let t = true
    let f = false
    println("{t and f} {t or f} {not t} {f and side_effect()} {t or side_effect()}")

    // Nested match on enums with data.
    let r: Result[Option[i32], String] = Ok(Some(3))
    let text = match r {
        Ok(Some(n)) if n > 2 => "big {n}"
        Ok(Some(n)) => "small {n}"
        Ok(None) => "empty"
        Err(e) => e.clone()
    }
    println(text)
    let c = 'q'
    let kind = match c {
        'a'..='m' => "first half"
        'n'..='z' => "second half"
        _ => "other"
    }
    println(kind)
}

fn side_effect() -> bool {
    println("side effect!")
    return true
}
