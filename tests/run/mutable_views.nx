// Arbre binaire de recherche, modifié sur place avec `match &arbre`.
// Exécution : nxc run examples/arbre.nx

struct Node {
    value: i32
    indirect left: Option[Node]
    indirect right: Option[Node]
}

fn insert(inout tree: Option[Node], value: i32) {
    match &tree {
        Some(node) => {
            if value < node.value {
                insert(&node.left, value)
            } else if value > node.value {
                insert(&node.right, value)
            }
        }
        None => tree = Some(Node(value: value, left: None, right: None))
    }
}

fn contains(tree: Option[Node], value: i32) -> bool {
    match tree {
        Some(node) => {
            if value == node.value {
                return true
            }
            if value < node.value {
                return contains(node.left, value)
            }
            return contains(node.right, value)
        }
        None => return false
    }
}

fn in_order(tree: Option[Node], inout out: Vec[i32]) {
    if let Some(node) = tree {
        in_order(node.left, &out)
        out.push(node.value)
        in_order(node.right, &out)
    }
}

fn height(tree: Option[Node]) -> u32 {
    return match tree {
        Some(node) => 1 + height(node.left).max(height(node.right))
        None => 0
    }
}

fn double_all(inout tree: Option[Node]) {
    if let Some(node) = &tree {
        node.value *= 2
        double_all(&node.left)
        double_all(&node.right)
    }
}

fn main() {
    var tree: Option[Node] = None
    for v in [50, 30, 70, 20, 40, 60, 80, 35, 45, 65] {
        insert(&tree, v)
    }
    var sorted: Vec[i32] = Vec.new()
    in_order(tree, &sorted)
    var text = String.new()
    for v in sorted {
        text += "{v} "
    }
    println("sorted: {text.trim()}")
    println("height: {height(tree)}")
    println("contains 45: {contains(tree, 45)}, contains 99: {contains(tree, 99)}")
    double_all(&tree)
    var doubled: Vec[i32] = Vec.new()
    in_order(tree, &doubled)
    println("doubled min/max: {doubled[0]} {doubled[doubled.len() - 1]}")

    var scores = [3, 1, 4, 1, 5]
    for s in &scores {
        s *= 10
    }
    var total = 0
    for s in scores {
        total += s
    }
    println("scaled total: {total}")
}
