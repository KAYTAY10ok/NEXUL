@@ -17,12 +17,43 @@
     - name: Build
       run: cargo build --workspace --exclude nexul-installer --verbose
     - name: Run tests
-      run: cargo test --workspace --exclude nexul-installer --verbose
+      run: cargo test --release --workspace --exclude nexul-installer --verbose
+    - name: Run browser ABI tests (including export validation)
